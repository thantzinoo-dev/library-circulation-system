@page
@model School_Library_Management.Pages.Reports.IndexModel
@{
    ViewData["Title"] = "Reports";
}

<section class="space-y-5">
    <header class="page-motion page-motion-header">
        <h1 class="text-2xl font-bold tracking-tight text-ink-900 sm:text-[28px]">Reports</h1>
        <p class="mt-1 text-sm text-ink-500">View library analytics and summary reports</p>
    </header>

    <div class="page-motion page-motion-filter rounded-xl border border-line-200 bg-white p-4 shadow-[0_1px_2px_rgba(16,24,40,0.03)] sm:p-5">
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
            <div class="relative min-w-0"><label for="report-range" class="sr-only">Date range</label><svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18"/></svg><input id="report-range" placeholder="Select date range" class="min-h-11 w-full min-w-0 rounded-lg border border-line-300 bg-white pl-10 pr-3 text-sm text-ink-900 placeholder:text-ink-400 outline-none focus:border-brand-600 focus:ring-2 focus:ring-brand-600/15" /></div>
            <div class="min-w-0"><label for="report-type" class="sr-only">Report type</label><select id="report-type" data-custom-select class="min-h-11 w-full min-w-0 rounded-lg border border-line-300 bg-white px-3 text-sm text-ink-700"><option>All Report Types</option><option>Borrowings</option><option>Returns</option><option>Fines</option></select></div>
            <div class="min-w-0 sm:col-span-2 lg:col-span-1"><label for="report-period" class="sr-only">Period</label><select id="report-period" data-custom-select class="min-h-11 w-full min-w-0 rounded-lg border border-line-300 bg-white px-3 text-sm text-ink-700"><option>This Month</option><option>Last Month</option><option>This Year</option></select></div>
        </div>

        <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-4">
            <button type="button" class="col-span-2 inline-flex min-h-11 min-w-0 w-full items-center justify-center gap-2 rounded-lg bg-brand-600 px-3 text-sm font-semibold text-white hover:bg-brand-700"><svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg><span class="truncate">Generate</span></button>
            <button type="button" class="inline-flex min-h-11 min-w-0 w-full items-center justify-center gap-2 rounded-lg border border-line-300 bg-white px-3 text-sm font-semibold text-ink-700 hover:bg-slate-50"><svg class="h-4 w-4 shrink-0 text-red-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2h8l4 4v16H6zM14 2v5h5"/><path d="M8 16h8M8 12h6"/></svg><span class="truncate">Export PDF</span></button>
            <button type="button" class="inline-flex min-h-11 min-w-0 w-full items-center justify-center gap-2 rounded-lg border border-line-300 bg-white px-3 text-sm font-semibold text-ink-700 hover:bg-slate-50"><svg class="h-4 w-4 shrink-0 text-green-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2h8l4 4v16H6zM14 2v5h5"/><path d="m9 12 6 6M15 12l-6 6"/></svg><span class="truncate">Export Excel</span></button>
        </div>
    </div>

    <div class="page-motion page-motion-content grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <article class="flex items-center gap-4 rounded-xl border border-line-200 bg-white p-5"><span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-blue-50 text-brand-600"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H11v16H6.5A2.5 2.5 0 0 0 4 21.5V5.5ZM20 5.5A2.5 2.5 0 0 0 17.5 3H13v16h4.5a2.5 2.5 0 0 1 2.5 2.5v-16Z"/></svg></span><div><p class="text-sm text-ink-500">Total Borrowings</p><p class="text-2xl font-bold text-brand-600">256</p><p class="text-xs text-ink-500">This Month</p></div></article>
        <article class="flex items-center gap-4 rounded-xl border border-line-200 bg-white p-5"><span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-green-50 text-green-600"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 7-5 5 5 5M4 12h11a5 5 0 0 1 5 5v2"/></svg></span><div><p class="text-sm text-ink-500">Returned Books</p><p class="text-2xl font-bold text-green-600">156</p><p class="text-xs text-ink-500">This Month</p></div></article>
        <article class="flex items-center gap-4 rounded-xl border border-line-200 bg-white p-5"><span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-amber-50 text-amber-600"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v6M12 17h.01"/></svg></span><div><p class="text-sm text-ink-500">Overdue Books</p><p class="text-2xl font-bold text-amber-600">16</p><p class="text-xs text-ink-500">This Month</p></div></article>
        <article class="flex items-center gap-4 rounded-xl border border-line-200 bg-white p-5"><span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-purple-50 text-purple-600"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="6" width="18" height="13" rx="3"/><path d="M16 10h5v5h-5a2.5 2.5 0 0 1 0-5Z"/></svg></span><div><p class="text-sm text-ink-500">Fine Collected</p><p class="text-2xl font-bold text-purple-600">85,000 <span class="text-base">MMK</span></p><p class="text-xs text-ink-500">This Month</p></div></article>
    </div>

    <div class="grid gap-4 xl:grid-cols-2">
        <article class="page-motion page-motion-content rounded-xl border border-line-200 bg-white p-4 shadow-[0_1px_2px_rgba(16,24,40,0.03)] sm:p-5">
            <h2 class="flex items-center gap-2 font-semibold text-ink-900"><svg class="h-4 w-4 text-brand-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg>Monthly Borrowing Overview</h2>
            <div class="mt-4 overflow-hidden">
                <svg class="h-auto w-full" viewBox="0 0 620 270" role="img" aria-labelledby="monthly-chart-title monthly-chart-desc">
                    <title id="monthly-chart-title">Monthly borrowing overview</title><desc id="monthly-chart-desc">Borrowings increased from 180 in January to 256 in June, with 210 in February, 250 in March, 220 in April and 240 in May.</desc>
                    <g fill="none" stroke="currentColor" class="text-line-200"><path d="M55 35H600M55 75H600M55 115H600M55 155H600M55 195H600M55 235H600"/><path d="M55 25V235H600"/></g>
                    <g fill="currentColor" class="text-ink-500" font-size="11"><text x="27" y="239">0</text><text x="20" y="199">50</text><text x="14" y="159">100</text><text x="14" y="119">150</text><text x="14" y="79">200</text><text x="14" y="39">250</text></g>
                    <g fill="currentColor" class="text-brand-600"><rect x="78" y="91" width="48" height="144" rx="4"/><rect x="166" y="67" width="48" height="168" rx="4"/><rect x="254" y="35" width="48" height="200" rx="4"/><rect x="342" y="59" width="48" height="176" rx="4"/><rect x="430" y="43" width="48" height="192" rx="4"/><rect x="518" y="30" width="48" height="205" rx="4"/></g>
                    <g fill="currentColor" class="text-ink-900" font-size="11" font-weight="600" text-anchor="middle"><text x="102" y="83">180</text><text x="190" y="59">210</text><text x="278" y="27">250</text><text x="366" y="51">220</text><text x="454" y="35">240</text><text x="542" y="22">256</text></g>
                    <g fill="currentColor" class="text-ink-500" font-size="11" text-anchor="middle"><text x="102" y="257">Jan</text><text x="190" y="257">Feb</text><text x="278" y="257">Mar</text><text x="366" y="257">Apr</text><text x="454" y="257">May</text><text x="542" y="257">Jun</text></g>
                </svg>
            </div>
        </article>

        <article class="page-motion page-motion-content rounded-xl border border-line-200 bg-white p-4 shadow-[0_1px_2px_rgba(16,24,40,0.03)] sm:p-5">
            <h2 class="flex items-center gap-2 font-semibold text-ink-900"><svg class="h-4 w-4 text-brand-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg>Books by Category</h2>
            <div class="mt-5 grid items-center gap-6 sm:grid-cols-[minmax(11rem,.9fr)_minmax(12rem,1.1fr)]">
                <div class="mx-auto w-full max-w-56">
                    <svg viewBox="0 0 42 42" class="h-auto w-full -rotate-90" role="img" aria-labelledby="category-chart-title category-chart-desc"><title id="category-chart-title">Books by category</title><desc id="category-chart-desc">Programming 30 percent, Fiction 25 percent, Self-Help 20 percent, Business 15 percent and Computer Science 10 percent.</desc><circle cx="21" cy="21" r="15.9155" fill="none" stroke="currentColor" stroke-width="8" class="text-line-200"/><circle cx="21" cy="21" r="15.9155" fill="none" stroke="#1468E8" stroke-width="8" pathLength="100" stroke-dasharray="30 70" stroke-dashoffset="0"/><circle cx="21" cy="21" r="15.9155" fill="none" stroke="#20B97A" stroke-width="8" pathLength="100" stroke-dasharray="25 75" stroke-dashoffset="-30"/><circle cx="21" cy="21" r="15.9155" fill="none" stroke="#F59E0B" stroke-width="8" pathLength="100" stroke-dasharray="20 80" stroke-dashoffset="-55"/><circle cx="21" cy="21" r="15.9155" fill="none" stroke="#7C3AED" stroke-width="8" pathLength="100" stroke-dasharray="15 85" stroke-dashoffset="-75"/><circle cx="21" cy="21" r="15.9155" fill="none" stroke="#22A7C7" stroke-width="8" pathLength="100" stroke-dasharray="10 90" stroke-dashoffset="-90"/></svg>
                </div>
                <ul class="space-y-3 text-sm">
                    @foreach (var category in Model.CategoryShares)
                    {
                        <li class="flex items-center gap-3"><span class="h-2.5 w-2.5 shrink-0 rounded-full" style="background-color: @category.Color"></span><span class="flex-1 text-ink-700">@category.Label</span><strong class="text-ink-900">@category.Percentage%</strong></li>
                    }
                </ul>
            </div>
        </article>
    </div>

    <div class="page-motion page-motion-table overflow-hidden rounded-xl border border-line-200 bg-white shadow-[0_1px_2px_rgba(16,24,40,0.03)]">
        <div class="border-b border-line-200 px-4 py-3 sm:px-5"><h2 class="flex items-center gap-2 font-semibold text-brand-600"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="m12 2.8 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-2.9L6.4 20l1.1-6.2L3 9.4l6.2-.9L12 2.8Z"/></svg>Popular Books Report</h2></div>
        <div class="overflow-x-auto"><table class="w-full min-w-225 text-left text-sm"><thead class="bg-slate-50 text-xs font-semibold uppercase tracking-wide text-ink-500"><tr><th class="px-5 py-3">Book Title</th><th class="px-5 py-3">Category</th><th class="px-5 py-3 text-center">Total Borrowed</th><th class="px-5 py-3 text-center">Available Copies</th><th class="px-5 py-3">Fine Generated</th><th class="px-5 py-3 text-center">Action</th></tr></thead><tbody class="divide-y divide-line-200">
        @foreach (var book in Model.PopularBooks)
        {
            var copiesClass = book.AvailableCopies <= 2 ? "text-red-600" : book.AvailableCopies <= 5 ? "text-amber-600" : "text-green-600";
            <tr class="text-ink-700 hover:bg-slate-50/70"><td class="px-5 py-3"><div class="flex items-center gap-3"><span class="flex h-9 w-7 shrink-0 items-center justify-center rounded bg-brand-600 text-[9px] font-bold text-white">@book.Initials</span><span class="whitespace-nowrap font-semibold text-ink-900">@book.Title</span></div></td><td class="px-5 py-3"><span class="rounded-md bg-blue-50 px-2.5 py-1 text-xs font-semibold text-brand-600">@book.Category</span></td><td class="px-5 py-3 text-center">@book.TotalBorrowed</td><td class="px-5 py-3 text-center font-semibold @copiesClass">@book.AvailableCopies</td><td class="whitespace-nowrap px-5 py-3">@book.FineGenerated</td><td class="px-5 py-3 text-center"><button type="button" class="rounded-md border border-brand-600 px-3 py-1 text-xs font-semibold text-brand-600 hover:bg-blue-50">View</button></td></tr>
        }
        </tbody></table></div>
        <div class="flex flex-col gap-3 border-t border-line-200 px-5 py-3 text-sm text-ink-500 sm:flex-row sm:items-center sm:justify-between"><span>Showing 1 to 5 of 5 entries</span><div class="flex gap-2"><button type="button" disabled class="h-9 w-9 rounded-lg border border-line-300 text-ink-400">‹</button><button type="button" class="h-9 w-9 rounded-lg bg-brand-600 font-semibold text-white">1</button><button type="button" disabled class="h-9 w-9 rounded-lg border border-line-300 text-ink-400">›</button></div></div>
    </div>
</section>
