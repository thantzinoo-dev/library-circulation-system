@page
@model School_Library_Management.Pages.Reports.IndexModel
@{
    ViewData["Title"] = "Reports";
    // Keep the breakdown scannable even if more categories are added later.
    var visibleCategoryShares = Model.CategoryShares.Take(6).ToList();
}

<section class="space-y-5">
    <header class="page-motion page-motion-header">
        <h1 class="text-2xl font-bold tracking-tight text-ink-900 sm:text-[28px]">Reports</h1>
        <p class="mt-1 text-sm text-ink-500">View library analytics and summary reports</p>
    </header>

    <form method="get" class="page-motion page-motion-filter rounded-xl border border-line-200 bg-white p-4 shadow-[0_1px_2px_rgba(16,24,40,0.03)] sm:p-5">
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
            <div class="report-control-field relative min-w-0"><label for="report-range" class="sr-only">Selected reporting range</label><svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18"/></svg><input id="report-range" value="Database reporting period" readonly class="h-11 w-full min-w-0 rounded-lg border border-line-300 bg-slate-50 pl-10 pr-3 text-sm leading-none text-ink-500" /></div>
            <div class="report-control-field min-w-0"><label asp-for="ReportType" class="sr-only">Report type</label><select asp-for="ReportType" data-custom-select class="h-11 w-full min-w-0 rounded-lg border border-line-300 bg-white px-3 text-sm text-ink-700"><option value="All">All Report Types</option><option value="Borrowings">Borrowings</option><option value="Returns">Returns</option><option value="Fines">Fines</option></select></div>
            <div class="report-control-field min-w-0 sm:col-span-2 lg:col-span-1"><label asp-for="Period" class="sr-only">Period</label><select asp-for="Period" data-custom-select class="h-11 w-full min-w-0 rounded-lg border border-line-300 bg-white px-3 text-sm text-ink-700"><option value="ThisMonth">This Month</option><option value="LastMonth">Last Month</option><option value="ThisYear">This Year</option><option value="All">All Time</option></select></div>
        </div>

        <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-4">
            <button type="submit" class="col-span-2 inline-flex min-h-11 min-w-0 w-full items-center justify-center gap-2 rounded-lg bg-brand-600 px-3 text-sm font-semibold text-white hover:bg-brand-700"><svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg><span class="truncate">Generate</span></button>
            @if (Model.ShowPdfExport)
            {
                <button type="button" class="inline-flex min-h-11 min-w-0 w-full items-center justify-center gap-2 rounded-lg border border-line-300 bg-white px-3 text-sm font-semibold text-ink-700 hover:bg-slate-50"><svg class="h-4 w-4 shrink-0 text-red-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2h8l4 4v16H6zM14 2v5h5"/><path d="M8 16h8M8 12h6"/></svg><span class="truncate">Export PDF</span></button>
            }
            @if (Model.ShowExcelExport)
            {
                <button type="button" class="inline-flex min-h-11 min-w-0 w-full items-center justify-center gap-2 rounded-lg border border-line-300 bg-white px-3 text-sm font-semibold text-ink-700 hover:bg-slate-50"><svg class="h-4 w-4 shrink-0 text-green-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2h8l4 4v16H6zM14 2v5h5"/><path d="m9 12 6 6M15 12l-6 6"/></svg><span class="truncate">Export Excel</span></button>
            }
        </div>
    </form>

    <div class="page-motion page-motion-content grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <article class="flex items-center gap-4 rounded-xl border border-line-200 bg-white p-5"><span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-blue-50 text-brand-600"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H11v16H6.5A2.5 2.5 0 0 0 4 21.5V5.5ZM20 5.5A2.5 2.5 0 0 0 17.5 3H13v16h4.5a2.5 2.5 0 0 1 2.5 2.5v-16Z"/></svg></span><div><p class="text-sm text-ink-500">Total Borrowings</p><p class="text-2xl font-bold text-brand-600">@Model.TotalBorrowings</p><p class="text-xs text-ink-500">Selected period</p></div></article>
        <article class="flex items-center gap-4 rounded-xl border border-line-200 bg-white p-5"><span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-green-50 text-green-600"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 7-5 5 5 5M4 12h11a5 5 0 0 1 5 5v2"/></svg></span><div><p class="text-sm text-ink-500">Returned Books</p><p class="text-2xl font-bold text-green-600">@Model.ReturnedBooks</p><p class="text-xs text-ink-500">Selected period</p></div></article>
        <article class="flex items-center gap-4 rounded-xl border border-line-200 bg-white p-5"><span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-amber-50 text-amber-600"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v6M12 17h.01"/></svg></span><div><p class="text-sm text-ink-500">Overdue Books</p><p class="text-2xl font-bold text-amber-600">@Model.OverdueBooks</p><p class="text-xs text-ink-500">Selected period</p></div></article>
        <article class="flex items-center gap-4 rounded-xl border border-line-200 bg-white p-5"><span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-purple-50 text-purple-600"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="6" width="18" height="13" rx="3"/><path d="M16 10h5v5h-5a2.5 2.5 0 0 1 0-5Z"/></svg></span><div><p class="text-sm text-ink-500">Fine Collected</p><p class="text-2xl font-bold text-purple-600">@Model.FineCollected.ToString("N0") <span class="text-base">MMK</span></p><p class="text-xs text-ink-500">Selected period</p></div></article>
    </div>

    <div class="grid items-start gap-4 xl:grid-cols-2">
        <article class="page-motion page-motion-content h-fit rounded-xl border border-line-200 bg-white p-4 shadow-[0_1px_2px_rgba(16,24,40,0.03)] sm:p-5">
            <h2 class="flex items-center gap-2 font-semibold text-ink-900"><svg class="h-4 w-4 text-brand-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg>Monthly Borrowing Overview</h2>
            <div class="mt-4 overflow-hidden">
                <svg class="h-auto w-full" viewBox="0 0 620 270" role="img" aria-labelledby="monthly-chart-title monthly-chart-desc">
                    <title id="monthly-chart-title">Monthly borrowing overview</title><desc id="monthly-chart-desc">Borrowing quantities for the latest six months from the database.</desc>
                    <g fill="none" stroke="currentColor" class="text-line-200"><path d="M55 35H600M55 75H600M55 115H600M55 155H600M55 195H600M55 235H600"/><path d="M55 25V235H600"/></g>
                    <g fill="currentColor" class="text-ink-500" font-size="11"><text x="27" y="239">0</text><text x="20" y="199">@((Model.MonthlyChartMax * 1) / 5)</text><text x="20" y="159">@((Model.MonthlyChartMax * 2) / 5)</text><text x="20" y="119">@((Model.MonthlyChartMax * 3) / 5)</text><text x="20" y="79">@((Model.MonthlyChartMax * 4) / 5)</text><text x="20" y="39">@Model.MonthlyChartMax</text></g>
                    @for (var index = 0; index < Model.MonthlyBorrowings.Count; index++)
                    {
                        var item = Model.MonthlyBorrowings[index];
                        var x = 78 + (index * 88);
                        var height = item.Count / (double)Model.MonthlyChartMax * 200;
                        var y = 235 - height;
                        <g>
                            <rect x="@x" y="@y.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" width="48" height="@height.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" rx="4" fill="currentColor" class="text-brand-600"/>
                            <text x="@(x + 24)" y="@Math.Max(18, y - 8).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" fill="currentColor" class="text-ink-900" font-size="11" font-weight="600" text-anchor="middle">@item.Count</text>
                            <text x="@(x + 24)" y="257" fill="currentColor" class="text-ink-500" font-size="11" text-anchor="middle">@item.Month</text>
                        </g>
                    }
                </svg>
            </div>
        </article>

        <article class="page-motion page-motion-content h-fit rounded-xl border border-line-200 bg-white p-4 shadow-[0_1px_2px_rgba(16,24,40,0.03)] sm:p-5">
            <h2 class="flex items-center gap-2 font-semibold text-ink-900"><svg class="h-4 w-4 text-brand-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg>Books by Category</h2>
            <div class="mt-5 grid items-center gap-5 sm:grid-cols-[minmax(10rem,.85fr)_minmax(13rem,1.15fr)]">
                <div class="mx-auto w-full max-w-48">
                    <svg viewBox="0 0 42 42" class="h-auto w-full -rotate-90" role="img" aria-labelledby="category-chart-title category-chart-desc"><title id="category-chart-title">Books by category</title><desc id="category-chart-desc">The five largest book categories by total copies, with remaining categories grouped as Other.</desc><circle cx="21" cy="21" r="15.9155" fill="none" stroke="currentColor" stroke-width="8" class="text-line-200"/>@foreach (var category in visibleCategoryShares) { <circle cx="21" cy="21" r="15.9155" fill="none" stroke="@category.Color" stroke-width="8" pathLength="100" stroke-dasharray="@category.Percentage.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture) 100" stroke-dashoffset="@((-category.Offset).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture))"/> }</svg>
                </div>
                <ul class="space-y-2.5 text-sm">
                    @foreach (var category in visibleCategoryShares)
                    {
                        <li class="flex min-w-0 items-center gap-3"><span class="h-2.5 w-2.5 shrink-0 rounded-full" style="background-color: @category.Color"></span><span class="min-w-0 flex-1 truncate text-ink-700" title="@category.Label">@category.Label</span><strong class="shrink-0 text-ink-900">@category.Percentage.ToString("0.#")%</strong></li>
                    }
                    @if (Model.CategoryShares.Count == 0) { <li class="text-ink-500">No books to summarize.</li> }
                </ul>
            </div>
        </article>
    </div>

    <div class="page-motion page-motion-table overflow-hidden rounded-xl border border-line-200 bg-white shadow-[0_1px_2px_rgba(16,24,40,0.03)]">
        <div class="border-b border-line-200 px-4 py-3 sm:px-5"><h2 class="flex items-center gap-2 font-semibold text-brand-600"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="m12 2.8 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-2.9L6.4 20l1.1-6.2L3 9.4l6.2-.9L12 2.8Z"/></svg>Popular Books Report</h2></div>
        <div class="overflow-x-auto"><table class="w-full min-w-225 text-left text-sm"><thead class="bg-slate-50 text-xs font-semibold uppercase tracking-wide text-ink-500"><tr><th class="px-5 py-3">Book Title</th><th class="px-5 py-3">Category</th><th class="px-5 py-3 text-center">Total Borrowed</th><th class="px-5 py-3 text-center">Available Copies</th><th class="px-5 py-3">Fine Generated</th><th class="px-5 py-3 text-center">Action</th></tr></thead><tbody class="divide-y divide-line-200">
        @foreach (var book in Model.PopularBooks)
        {
            var copiesClass = book.AvailableCopies <= 2 ? "text-red-600" : book.AvailableCopies <= 5 ? "text-amber-600" : "text-green-600";
            <tr class="text-ink-700 hover:bg-slate-50/70"><td class="px-5 py-3"><div class="flex items-center gap-3">@if (!string.IsNullOrWhiteSpace(book.CoverImagePath)) { <img src="@book.CoverImagePath" alt="Cover of @book.Title" class="h-11 w-8 shrink-0 rounded object-cover shadow-sm" loading="lazy" /> } else { <span class="flex h-11 w-8 shrink-0 items-center justify-center rounded bg-brand-600 text-[9px] font-bold text-white">@book.Initials</span> }<span class="whitespace-nowrap font-semibold text-ink-900">@book.Title</span></div></td><td class="px-5 py-3"><span class="rounded-md bg-blue-50 px-2.5 py-1 text-xs font-semibold text-brand-600">@book.Category</span></td><td class="px-5 py-3 text-center">@book.TotalBorrowed</td><td class="px-5 py-3 text-center font-semibold @copiesClass">@book.AvailableCopies</td><td class="whitespace-nowrap px-5 py-3">@book.FineGenerated.ToString("N0") MMK</td><td class="px-5 py-3 text-center"><a asp-page="/History/Index" asp-route-search="@book.Title" asp-route-period="All" class="rounded-md border border-brand-600 px-3 py-1 text-xs font-semibold text-brand-600 hover:bg-blue-50">View</a></td></tr>
        }
        @if (Model.PopularBooks.Count == 0) { <tr><td colspan="6" class="px-5 py-10 text-center text-ink-500">No borrowing data for the selected period.</td></tr> }
        </tbody></table></div>
        <div class="border-t border-line-200 px-5 py-3 text-sm text-ink-500">Showing @Model.PopularBooks.Count popular book@(Model.PopularBooks.Count == 1 ? "" : "s")</div>
    </div>
</section>
