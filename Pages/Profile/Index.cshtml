@page
@model School_Library_Management.Pages.Profile.IndexModel
@{
    ViewData["Title"] = "Profile";
}

<section class="mx-auto max-w-5xl space-y-6">
    <header class="page-motion page-motion-header">
        <h1 class="text-2xl font-bold tracking-tight text-ink-900 sm:text-[28px]">Profile</h1>
        <p class="mt-1 text-sm text-ink-500">Manage the library administrator account details.</p>
    </header>

    <div class="grid gap-5 lg:grid-cols-[16rem_minmax(0,1fr)]">
        <aside class="page-motion page-motion-content rounded-xl border border-line-200 bg-white p-6 text-center shadow-[0_1px_2px_rgba(16,24,40,0.03)]">
            <span class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-brand-600 text-2xl font-bold text-white">@Model.Initials</span>
            <h2 class="mt-4 font-semibold text-ink-900">@Model.Input.FullName</h2>
            <p class="mt-1 text-sm text-ink-500">@Model.Input.Role</p>
            <div class="my-5 h-px bg-line-200"></div>
            <p class="text-xs leading-5 text-ink-500">Account details are stored in the application database.</p>
            <a asp-page="/Profile/Password" class="mt-4 inline-flex min-h-10 w-full items-center justify-center rounded-lg border border-line-300 bg-white px-4 text-sm font-semibold text-ink-700 hover:bg-slate-50">Change password</a>
        </aside>

        <form method="post" class="page-motion page-motion-content overflow-hidden rounded-xl border border-line-200 bg-white shadow-[0_1px_2px_rgba(16,24,40,0.03)]">
            <div class="border-b border-line-200 px-5 py-4 sm:px-6">
                <h2 class="font-semibold text-ink-900">Personal information</h2>
                <p class="mt-1 text-sm text-ink-500">Keep contact and role information up to date.</p>
            </div>
            <div class="space-y-5 p-5 sm:p-6">
                <div asp-validation-summary="ModelOnly" class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800 empty:hidden" role="alert"></div>
                <div class="grid gap-5 sm:grid-cols-2">
                    <div><label asp-for="Input.FullName" class="mb-1.5 block text-sm font-semibold text-ink-700"></label><input asp-for="Input.FullName" class="min-h-10 w-full rounded-lg border border-line-300 bg-white px-3 py-2 text-sm text-ink-900 outline-none focus:border-brand-600 focus:ring-2 focus:ring-brand-600/15" /><span asp-validation-for="Input.FullName" class="mt-1 block text-sm text-red-700"></span></div>
                    <div><label asp-for="Input.Role" class="mb-1.5 block text-sm font-semibold text-ink-700"></label><input asp-for="Input.Role" class="min-h-10 w-full rounded-lg border border-line-300 bg-white px-3 py-2 text-sm text-ink-900 outline-none focus:border-brand-600 focus:ring-2 focus:ring-brand-600/15" /><span asp-validation-for="Input.Role" class="mt-1 block text-sm text-red-700"></span></div>
                    <div><label asp-for="Input.Email" class="mb-1.5 block text-sm font-semibold text-ink-700"></label><input asp-for="Input.Email" class="min-h-10 w-full rounded-lg border border-line-300 bg-white px-3 py-2 text-sm text-ink-900 outline-none focus:border-brand-600 focus:ring-2 focus:ring-brand-600/15" /><span asp-validation-for="Input.Email" class="mt-1 block text-sm text-red-700"></span></div>
                    <div><label asp-for="Input.Phone" class="mb-1.5 block text-sm font-semibold text-ink-700"></label><input asp-for="Input.Phone" class="min-h-10 w-full rounded-lg border border-line-300 bg-white px-3 py-2 text-sm text-ink-900 outline-none focus:border-brand-600 focus:ring-2 focus:ring-brand-600/15" /><span asp-validation-for="Input.Phone" class="mt-1 block text-sm text-red-700"></span></div>
                    <div class="sm:col-span-2"><label asp-for="Input.Department" class="mb-1.5 block text-sm font-semibold text-ink-700"></label><input asp-for="Input.Department" class="min-h-10 w-full rounded-lg border border-line-300 bg-white px-3 py-2 text-sm text-ink-900 outline-none focus:border-brand-600 focus:ring-2 focus:ring-brand-600/15" /><span asp-validation-for="Input.Department" class="mt-1 block text-sm text-red-700"></span></div>
                    <div class="sm:col-span-2"><label asp-for="Input.Bio" class="mb-1.5 block text-sm font-semibold text-ink-700"></label><textarea asp-for="Input.Bio" rows="4" class="w-full resize-y rounded-lg border border-line-300 bg-white px-3 py-2 text-sm text-ink-900 outline-none focus:border-brand-600 focus:ring-2 focus:ring-brand-600/15"></textarea><span asp-validation-for="Input.Bio" class="mt-1 block text-sm text-red-700"></span></div>
                </div>
            </div>
            <div class="flex flex-col-reverse gap-3 border-t border-line-200 bg-slate-50/70 px-5 py-4 sm:flex-row sm:justify-end sm:px-6">
                <a asp-page="/Index" class="inline-flex min-h-10 items-center justify-center rounded-lg border border-line-300 bg-white px-5 text-sm font-semibold text-ink-700 hover:bg-slate-50">Cancel</a>
                <button type="submit" class="inline-flex min-h-10 items-center justify-center rounded-lg bg-brand-600 px-5 text-sm font-semibold text-white hover:bg-brand-700">Save profile</button>
            </div>
        </form>
    </div>
</section>
