@page
@model School_Library_Management.Pages.Profile.PasswordModel
@{
    ViewData["Title"] = "Change Password";
}

<section class="mx-auto max-w-2xl space-y-6">
    <header class="page-motion page-motion-header">
        <h1 class="text-2xl font-bold tracking-tight text-ink-900 sm:text-[28px]">Change Password</h1>
        <p class="mt-1 text-sm text-ink-500">Protect the administrator account with a strong, unique password.</p>
    </header>

    @if (Model.FirstLogin)
    {
        <div class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800" role="status">
            Change the temporary administrator password before continuing.
        </div>
    }

    <form method="post" class="page-motion page-motion-content overflow-hidden rounded-xl border border-line-200 bg-white shadow-[0_1px_2px_rgba(16,24,40,0.03)]">
        <input asp-for="FirstLogin" type="hidden" />
        <div class="border-b border-line-200 px-5 py-4 sm:px-6">
            <h2 class="font-semibold text-ink-900">Account security</h2>
            <p class="mt-1 text-sm text-ink-500">Use at least 10 characters with uppercase, lowercase, a number, and a symbol.</p>
        </div>
        <div class="space-y-5 p-5 sm:p-6">
            <div asp-validation-summary="ModelOnly" class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800 empty:hidden" role="alert"></div>
            <div>
                <label asp-for="Input.CurrentPassword" class="mb-1.5 block text-sm font-semibold text-ink-700"></label>
                <input asp-for="Input.CurrentPassword" autocomplete="current-password" class="min-h-11 w-full rounded-lg border border-line-300 bg-white px-3 py-2 text-sm text-ink-900 outline-none focus:border-brand-600 focus:ring-2 focus:ring-brand-600/15" />
                <span asp-validation-for="Input.CurrentPassword" class="mt-1 block text-sm text-red-700"></span>
            </div>
            <div>
                <label asp-for="Input.NewPassword" class="mb-1.5 block text-sm font-semibold text-ink-700"></label>
                <input asp-for="Input.NewPassword" autocomplete="new-password" class="min-h-11 w-full rounded-lg border border-line-300 bg-white px-3 py-2 text-sm text-ink-900 outline-none focus:border-brand-600 focus:ring-2 focus:ring-brand-600/15" />
                <span asp-validation-for="Input.NewPassword" class="mt-1 block text-sm text-red-700"></span>
            </div>
            <div>
                <label asp-for="Input.ConfirmPassword" class="mb-1.5 block text-sm font-semibold text-ink-700"></label>
                <input asp-for="Input.ConfirmPassword" autocomplete="new-password" class="min-h-11 w-full rounded-lg border border-line-300 bg-white px-3 py-2 text-sm text-ink-900 outline-none focus:border-brand-600 focus:ring-2 focus:ring-brand-600/15" />
                <span asp-validation-for="Input.ConfirmPassword" class="mt-1 block text-sm text-red-700"></span>
            </div>
        </div>
        <div class="flex flex-col-reverse gap-3 border-t border-line-200 bg-slate-50/70 px-5 py-4 sm:flex-row sm:justify-end sm:px-6">
            @if (!Model.FirstLogin)
            {
                <a asp-page="/Profile/Index" class="inline-flex min-h-10 items-center justify-center rounded-lg border border-line-300 bg-white px-5 text-sm font-semibold text-ink-700 hover:bg-slate-50">Cancel</a>
            }
            <button type="submit" class="inline-flex min-h-10 items-center justify-center rounded-lg bg-brand-600 px-5 text-sm font-semibold text-white hover:bg-brand-700">Change password</button>
        </div>
    </form>
</section>
