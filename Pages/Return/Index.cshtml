@page
@model School_Library_Management.Pages.Return.IndexModel
@{
    ViewData["Title"] = "Return Book";
}

<section class="space-y-5">
    <header class="page-motion page-motion-header">
        <h1 class="text-2xl font-bold tracking-tight text-ink-900 sm:text-[28px]">Return Book</h1>
        <p class="mt-1 text-sm text-ink-500">Process returned books and review return activity</p>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-sm font-medium text-green-800" role="status">@Model.StatusMessage</div>
    }

    <a asp-page="./Create"
       class="page-motion page-motion-filter group flex flex-col gap-4 rounded-xl border border-line-200 bg-white p-5 shadow-[0_1px_2px_rgba(16,24,40,0.03)] hover:border-brand-600/40 hover:shadow-[0_8px_24px_rgba(16,24,40,0.06)] sm:flex-row sm:items-center sm:justify-between">
        <span class="flex min-w-0 items-center gap-4">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-brand-600">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m8 7-5 5 5 5"/><path d="M3 12h11a6 6 0 0 1 6 6v2"/></svg>
            </span>
            <span class="min-w-0">
                <span class="block font-semibold text-ink-900">Process a book return</span>
                <span class="mt-1 block text-sm text-ink-500">Find an open loan, review its details, and complete the return.</span>
            </span>
        </span>
        <span class="inline-flex items-center gap-2 self-start text-sm font-semibold text-brand-600 group-hover:text-brand-700 sm:self-auto">
            Start a return
            <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
        </span>
    </a>

    <div class="page-motion page-motion-content grid gap-4 md:grid-cols-3">
        <article class="flex items-center gap-4 rounded-xl border border-line-200 bg-white p-5">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-green-50 text-green-600"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2h9l4 4v13a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V5a3 3 0 0 1 3-3Z"/><path d="m8 15 2 2 5-5"/></svg></span>
            <div><p class="text-sm text-ink-500">Returned Today</p><p class="text-2xl font-bold text-green-600">@Model.ReturnedToday</p><p class="text-xs text-ink-500">Books returned today</p></div>
        </article>
        <article class="flex items-center gap-4 rounded-xl border border-line-200 bg-white p-5">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-amber-50 text-amber-600"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
            <div><p class="text-sm text-ink-500">Pending Returns</p><p class="text-2xl font-bold text-amber-600">@Model.PendingReturns</p><p class="text-xs text-ink-500">Books not yet returned</p></div>
        </article>
        <article class="flex items-center gap-4 rounded-xl border border-line-200 bg-white p-5">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-red-50 text-red-600"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v6M12 17h.01"/></svg></span>
            <div><p class="text-sm text-ink-500">Late Returns</p><p class="text-2xl font-bold text-red-600">@Model.LateReturns</p><p class="text-xs text-ink-500">Returned after due date</p></div>
        </article>
    </div>

    <div class="page-motion page-motion-table overflow-hidden rounded-xl border border-line-200 bg-white shadow-[0_1px_2px_rgba(16,24,40,0.03)]">
        <div class="flex items-center justify-between border-b border-line-200 px-4 py-3 sm:px-5">
            <h2 class="flex items-center gap-2 font-semibold text-ink-900"><svg class="h-5 w-5 text-brand-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>Recently Returned Books</h2>
            <a asp-page="/History/Index" asp-route-status="Returned" asp-route-period="All" class="text-sm font-semibold text-brand-600 hover:text-brand-700">View all</a>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full min-w-200 text-left text-sm">
                <thead class="bg-slate-50 text-xs font-semibold uppercase tracking-wide text-ink-500"><tr><th class="px-5 py-3">Loan ID</th><th class="px-5 py-3">Member Name</th><th class="px-5 py-3">Book Title</th><th class="px-5 py-3">Return Date</th><th class="px-5 py-3">Fine</th><th class="px-5 py-3">Condition</th><th class="px-5 py-3 text-center">Action</th></tr></thead>
                <tbody class="divide-y divide-line-200">
                    @foreach (var item in Model.RecentReturns)
                    {
                        var conditionClass = item.Condition switch { "Good" => "bg-green-50 text-green-700", "Late" => "bg-amber-50 text-amber-700", _ => "bg-red-50 text-red-700" };
                        <tr class="text-ink-700 hover:bg-slate-50/70"><td class="whitespace-nowrap px-5 py-3 font-semibold text-ink-900">@item.LoanId</td><td class="whitespace-nowrap px-5 py-3">@item.MemberName</td><td class="whitespace-nowrap px-5 py-3">@item.BookTitle</td><td class="whitespace-nowrap px-5 py-3">@item.ReturnDate.ToString("MMM dd, yyyy")</td><td class="whitespace-nowrap px-5 py-3">@item.FineAmount.ToString("N0") MMK</td><td class="px-5 py-3"><span class="rounded-md px-2.5 py-1 text-xs font-semibold @conditionClass">@item.Condition</span></td><td class="px-5 py-3 text-center"><a asp-page="/History/Index" asp-route-search="@item.LoanId" asp-route-period="All" class="rounded-md border border-brand-600 px-3 py-1 text-xs font-semibold text-brand-600 hover:bg-blue-50">View</a></td></tr>
                    }
                    @if (Model.RecentReturns.Count == 0)
                    {
                        <tr><td colspan="7" class="px-5 py-10 text-center text-ink-500">No books have been returned yet.</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="border-t border-line-200 px-5 py-3 text-sm text-ink-500">Showing @Model.RecentReturns.Count recent return@(Model.RecentReturns.Count == 1 ? "" : "s")</div>
    </div>
</section>
