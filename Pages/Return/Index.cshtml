@page
@model School_Library_Management.Pages.Return.IndexModel
@{
    ViewData["Title"] = "Return Book";
}

<section class="space-y-5">
    <header class="page-motion page-motion-header">
        <h1 class="text-2xl font-bold tracking-tight text-ink-900 sm:text-[28px]">Return Book</h1>
        <p class="mt-1 text-sm text-ink-500">Process returned books and update records</p>
    </header>

    <form class="page-motion page-motion-filter rounded-xl border border-line-200 bg-white p-4 shadow-[0_1px_2px_rgba(16,24,40,0.03)] sm:p-5">
        <div class="grid gap-x-10 gap-y-4 xl:grid-cols-2">
            <div class="space-y-4">
                <div class="grid gap-2 sm:grid-cols-[9rem_minmax(0,1fr)] sm:items-center"><label for="return-member" class="text-sm font-semibold text-ink-700">Member Name</label><select id="return-member" data-custom-select class="min-h-10 w-full rounded-lg border border-line-300 bg-white px-3 text-sm text-ink-700"><option>Aung Min Thant</option><option>Su Su Hlaing</option><option>Ko Ko Zaw</option></select></div>
                <div class="grid gap-2 sm:grid-cols-[9rem_minmax(0,1fr)] sm:items-center"><label for="return-book" class="text-sm font-semibold text-ink-700">Borrowed Book</label><select id="return-book" data-custom-select class="min-h-10 w-full rounded-lg border border-line-300 bg-white px-3 text-sm text-ink-700"><option>Clean Code</option><option>Atomic Habits</option><option>Deep Work</option></select></div>
                <div class="grid gap-2 sm:grid-cols-[9rem_minmax(0,1fr)] sm:items-center"><label for="loan-id" class="text-sm font-semibold text-ink-700">Loan ID</label><input id="loan-id" value="LOAN0001" readonly class="min-h-10 w-full rounded-lg border border-line-300 bg-slate-50 px-3 text-sm text-ink-600" /></div>
                <div class="grid gap-2 sm:grid-cols-[9rem_minmax(0,1fr)] sm:items-center"><label for="original-date" class="text-sm font-semibold text-ink-700">Borrow Date</label><div class="relative"><svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18"/></svg><input id="original-date" value="May 18, 2025" readonly class="min-h-10 w-full rounded-lg border border-line-300 bg-white pl-10 pr-3 text-sm text-ink-700" /></div></div>
                <div class="grid gap-2 sm:grid-cols-[9rem_minmax(0,1fr)] sm:items-center"><label for="return-quantity" class="text-sm font-semibold text-ink-700">Quantity</label><input id="return-quantity" type="number" min="1" value="1" class="min-h-10 w-full rounded-lg border border-line-300 bg-white px-3 text-sm text-ink-700 outline-none focus:border-brand-600 focus:ring-2 focus:ring-brand-600/15" /></div>
            </div>
            <div class="space-y-4">
                <div class="grid gap-2 sm:grid-cols-[8rem_minmax(0,1fr)] sm:items-center"><label for="return-student" class="text-sm font-semibold text-ink-700">Student ID</label><input id="return-student" value="STU001" readonly class="min-h-10 w-full rounded-lg border border-line-300 bg-slate-50 px-3 text-sm text-ink-600" /></div>
                <div class="grid gap-2 sm:grid-cols-[8rem_minmax(0,1fr)] sm:items-center"><label for="return-isbn" class="text-sm font-semibold text-ink-700">ISBN</label><input id="return-isbn" value="978-0132350884" readonly class="min-h-10 w-full rounded-lg border border-line-300 bg-slate-50 px-3 text-sm text-ink-600" /></div>
                <div class="grid gap-2 sm:grid-cols-[8rem_minmax(0,1fr)] sm:items-center"><label for="return-due" class="text-sm font-semibold text-ink-700">Due Date</label><div class="relative"><svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18"/></svg><input id="return-due" value="Jun 01, 2025" readonly class="min-h-10 w-full rounded-lg border border-line-300 bg-white pl-10 pr-3 text-sm text-ink-700" /></div></div>
                <div class="grid gap-2 sm:grid-cols-[8rem_minmax(0,1fr)] sm:items-center"><label for="return-date" class="text-sm font-semibold text-ink-700">Return Date</label><div class="relative"><svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18"/></svg><input id="return-date" value="Jun 01, 2025" readonly class="min-h-10 w-full rounded-lg border border-line-300 bg-white pl-10 pr-3 text-sm text-ink-700" /></div></div>
                <div class="grid gap-2 sm:grid-cols-[8rem_minmax(0,1fr)] sm:items-center"><label for="fine" class="text-sm font-semibold text-ink-700">Fine Amount</label><input id="fine" value="0" readonly class="min-h-10 w-full rounded-lg border border-line-300 bg-slate-50 px-3 text-sm text-ink-600" /></div>
                <div class="grid gap-2 sm:grid-cols-[8rem_minmax(0,1fr)]"><label for="return-notes" class="pt-2 text-sm font-semibold text-ink-700">Notes</label><textarea id="return-notes" rows="2" class="min-h-16 w-full resize-y rounded-lg border border-line-300 bg-white px-3 py-2 text-sm text-ink-700 outline-none focus:border-brand-600 focus:ring-2 focus:ring-brand-600/15">Returned in good condition.</textarea></div>
            </div>
        </div>
        <div class="mt-5 grid grid-cols-2 gap-3 sm:flex"><button type="button" class="inline-flex min-h-10 w-full items-center justify-center gap-2 rounded-lg bg-brand-600 px-5 text-sm font-semibold text-white hover:bg-brand-700 sm:w-36"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m8 7-5 5 5 5M3 12h18"/></svg>Return Book</button><button type="reset" class="inline-flex min-h-10 w-full items-center justify-center gap-2 rounded-lg border border-line-300 bg-white px-5 text-sm font-semibold text-ink-700 hover:bg-slate-50 sm:w-36"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>Reset</button></div>
    </form>

    <div class="page-motion page-motion-content grid gap-4 md:grid-cols-3">
        <article class="flex items-center gap-4 rounded-xl border border-line-200 bg-white p-5"><span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-green-50 text-green-600"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2h9l4 4v13a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V5a3 3 0 0 1 3-3Z"/><path d="m8 15 2 2 5-5"/></svg></span><div><p class="text-sm text-ink-500">Returned Today</p><p class="text-2xl font-bold text-green-600">24</p><p class="text-xs text-ink-500">Books returned today</p></div></article>
        <article class="flex items-center gap-4 rounded-xl border border-line-200 bg-white p-5"><span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-amber-50 text-amber-600"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span><div><p class="text-sm text-ink-500">Pending Returns</p><p class="text-2xl font-bold text-amber-600">9</p><p class="text-xs text-ink-500">Books not yet returned</p></div></article>
        <article class="flex items-center gap-4 rounded-xl border border-line-200 bg-white p-5"><span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-red-50 text-red-600"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v6M12 17h.01"/></svg></span><div><p class="text-sm text-ink-500">Late Returns</p><p class="text-2xl font-bold text-red-600">6</p><p class="text-xs text-ink-500">Returned after due date</p></div></article>
    </div>

    <div class="page-motion page-motion-table overflow-hidden rounded-xl border border-line-200 bg-white shadow-[0_1px_2px_rgba(16,24,40,0.03)]">
        <div class="flex items-center justify-between border-b border-line-200 px-4 py-3 sm:px-5"><h2 class="flex items-center gap-2 font-semibold text-ink-900"><svg class="h-5 w-5 text-brand-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>Recently Returned Books</h2><a href="/History" class="text-sm font-semibold text-brand-600 hover:text-brand-700">View all</a></div>
        <div class="overflow-x-auto"><table class="w-full min-w-200 text-left text-sm"><thead class="bg-slate-50 text-xs font-semibold uppercase tracking-wide text-ink-500"><tr><th class="px-5 py-3">Loan ID</th><th class="px-5 py-3">Member Name</th><th class="px-5 py-3">Book Title</th><th class="px-5 py-3">Return Date</th><th class="px-5 py-3">Fine</th><th class="px-5 py-3">Condition</th><th class="px-5 py-3 text-center">Action</th></tr></thead><tbody class="divide-y divide-line-200">
        @foreach (var item in Model.RecentReturns)
        {
            var conditionClass = item.Condition switch { "Good" => "bg-green-50 text-green-700", "Late" => "bg-amber-50 text-amber-700", _ => "bg-red-50 text-red-700" };
            <tr class="text-ink-700 hover:bg-slate-50/70"><td class="whitespace-nowrap px-5 py-3 font-semibold text-ink-900">@item.LoanId</td><td class="whitespace-nowrap px-5 py-3">@item.MemberName</td><td class="whitespace-nowrap px-5 py-3">@item.BookTitle</td><td class="whitespace-nowrap px-5 py-3">@item.ReturnDate</td><td class="whitespace-nowrap px-5 py-3">@item.Fine</td><td class="px-5 py-3"><span class="rounded-md px-2.5 py-1 text-xs font-semibold @conditionClass">@item.Condition</span></td><td class="px-5 py-3 text-center"><button type="button" class="rounded-md border border-brand-600 px-3 py-1 text-xs font-semibold text-brand-600 hover:bg-blue-50">View</button></td></tr>
        }
        </tbody></table></div>
        <div class="flex flex-col gap-3 border-t border-line-200 px-5 py-3 text-sm text-ink-500 sm:flex-row sm:items-center sm:justify-between"><span>Showing 1 to 6 of 6 records</span><div class="flex gap-2"><button type="button" disabled class="h-9 w-9 rounded-lg border border-line-300 text-ink-400">‹</button><button type="button" class="h-9 w-9 rounded-lg bg-brand-600 font-semibold text-white">1</button><button type="button" disabled class="h-9 w-9 rounded-lg border border-line-300 text-ink-400">›</button></div></div>
    </div>
</section>
