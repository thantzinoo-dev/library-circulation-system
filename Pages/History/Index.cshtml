@page
@model School_Library_Management.Pages.History.IndexModel
@{
    ViewData["Title"] = "Borrowing History";
}

<section class="space-y-5">
    <header class="page-motion page-motion-header">
        <h1 class="text-2xl font-bold tracking-tight text-ink-900 sm:text-[28px]">Borrowing History</h1>
        <p class="mt-1 text-sm text-ink-500">View and manage all borrowing records</p>
    </header>

    <div class="page-motion page-motion-filter rounded-xl border border-line-200 bg-white p-4 shadow-[0_1px_2px_rgba(16,24,40,0.03)] sm:p-5">
        <form method="get" class="flex flex-col gap-3 lg:flex-row lg:items-center" role="search">
            <div class="relative min-w-0 flex-1">
                <label for="history-search" class="sr-only">Search borrowing records</label>
                <input id="history-search" name="search"
                       placeholder="Search by loan ID, member or book..."
                       class="min-h-10 w-full rounded-lg border border-line-300 bg-white py-2 pl-3.5 pr-10 text-sm text-ink-900 placeholder:text-ink-400 outline-none focus:border-brand-600 focus:ring-2 focus:ring-brand-600/15" />
                <span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-ink-400">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
                </span>
            </div>

            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:flex lg:items-center">
                <div class="min-w-36">
                    <label for="history-status" class="sr-only">Status</label>
                    <select id="history-status" name="status" data-custom-select class="min-h-10 w-full rounded-lg border border-line-300 bg-white px-3 py-2 text-sm text-ink-700 outline-none hover:border-line-400 focus:border-brand-600 focus:ring-2 focus:ring-brand-600/15"><option>All Statuses</option><option>Borrowed</option><option>Returned</option><option>Overdue</option></select>
                </div>
                <div class="min-w-44">
                    <label for="history-period" class="sr-only">Period</label>
                    <select id="history-period" name="period" data-custom-select class="min-h-10 w-full rounded-lg border border-line-300 bg-white px-3 py-2 text-sm text-ink-700 outline-none hover:border-line-400 focus:border-brand-600 focus:ring-2 focus:ring-brand-600/15"><option>This Month</option><option>Last Month</option><option>This Year</option></select>
                </div>
                <button type="submit" class="inline-flex min-h-10 items-center justify-center gap-2 rounded-lg bg-brand-600 px-5 text-sm font-semibold text-white transition-colors hover:bg-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600/30"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg><span>Search</span></button>
                <a asp-page="./Index" class="inline-flex min-h-10 items-center justify-center gap-2 rounded-lg border border-line-300 bg-white px-4 text-sm font-semibold text-ink-700 transition-colors hover:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600/30"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg><span>Reset</span></a>
            </div>
        </form>
    </div>

    <div class="page-motion page-motion-content grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <article class="flex items-center gap-4 rounded-xl border border-line-200 bg-white p-5"><span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-blue-50 text-brand-600"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg></span><div><p class="text-sm text-ink-500">Total Records</p><p class="text-2xl font-bold text-brand-600">256</p><p class="text-xs text-ink-500">All borrowing records</p></div></article>
        <article class="flex items-center gap-4 rounded-xl border border-line-200 bg-white p-5"><span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-green-50 text-green-600"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 5h6v15H6a2 2 0 0 0-2 2V5Zm16 0h-6v15h4a2 2 0 0 1 2 2V5Z"/><circle cx="18" cy="17" r="3"/></svg></span><div><p class="text-sm text-ink-500">Borrowed</p><p class="text-2xl font-bold text-green-600">84</p><p class="text-xs text-ink-500">Currently borrowed</p></div></article>
        <article class="flex items-center gap-4 rounded-xl border border-line-200 bg-white p-5"><span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-purple-50 text-purple-600"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></svg></span><div><p class="text-sm text-ink-500">Returned</p><p class="text-2xl font-bold text-purple-600">156</p><p class="text-xs text-ink-500">Successfully returned</p></div></article>
        <article class="flex items-center gap-4 rounded-xl border border-line-200 bg-white p-5"><span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-red-50 text-red-600"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v6M12 17h.01"/></svg></span><div><p class="text-sm text-ink-500">Overdue</p><p class="text-2xl font-bold text-red-600">16</p><p class="text-xs text-ink-500">Past due date</p></div></article>
    </div>

    <div class="page-motion page-motion-table overflow-hidden rounded-xl border border-line-200 bg-white shadow-[0_1px_2px_rgba(16,24,40,0.03)]">
        <div class="flex items-center justify-between border-b border-line-200 px-4 py-3 sm:px-5"><h2 class="flex items-center gap-2 font-semibold text-ink-900"><svg class="h-5 w-5 text-brand-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>Borrowing Records</h2><span class="text-sm font-semibold text-brand-600">View all</span></div>
        <div class="overflow-x-auto"><table class="w-full min-w-275 text-left text-sm"><thead class="bg-slate-50 text-xs font-semibold uppercase tracking-wide text-ink-500"><tr><th class="px-4 py-3">Loan ID</th><th class="px-4 py-3">Member Name</th><th class="px-4 py-3">Book Title</th><th class="px-4 py-3">Borrow Date</th><th class="px-4 py-3">Due Date</th><th class="px-4 py-3">Return Date</th><th class="px-4 py-3">Status</th><th class="px-4 py-3">Fine</th><th class="px-4 py-3 text-center">Action</th></tr></thead><tbody class="divide-y divide-line-200">
        @foreach (var item in Model.Records)
        {
            var statusClass = item.Status switch { "Returned" => "bg-green-50 text-green-700", "Borrowed" => "bg-amber-50 text-amber-700", _ => "bg-red-50 text-red-700" };
            <tr class="text-ink-700 hover:bg-slate-50/70"><td class="whitespace-nowrap px-4 py-3 font-semibold text-ink-900">@item.LoanId</td><td class="whitespace-nowrap px-4 py-3">@item.MemberName</td><td class="whitespace-nowrap px-4 py-3">@item.BookTitle</td><td class="whitespace-nowrap px-4 py-3">@item.BorrowDate</td><td class="whitespace-nowrap px-4 py-3">@item.DueDate</td><td class="whitespace-nowrap px-4 py-3">@(item.ReturnDate ?? "—")</td><td class="px-4 py-3"><span class="rounded-md px-2.5 py-1 text-xs font-semibold @statusClass">@item.Status</span></td><td class="whitespace-nowrap px-4 py-3">@item.Fine</td><td class="px-4 py-3 text-center"><button type="button" class="rounded-md border border-brand-600 px-3 py-1 text-xs font-semibold text-brand-600 hover:bg-blue-50">View</button></td></tr>
        }
        </tbody></table></div>
        <div class="flex flex-col gap-3 border-t border-line-200 px-5 py-3 text-sm text-ink-500 sm:flex-row sm:items-center sm:justify-between"><span>Showing 1 to 8 of 256 records</span><nav class="flex flex-wrap gap-2" aria-label="Borrowing record pages"><button type="button" class="h-9 min-w-9 rounded-lg border border-line-300 px-2">«</button><button type="button" class="h-9 min-w-9 rounded-lg border border-line-300 px-2">‹</button><button type="button" class="h-9 min-w-9 rounded-lg bg-brand-600 px-2 font-semibold text-white" aria-current="page">1</button><button type="button" class="h-9 min-w-9 rounded-lg border border-line-300 px-2">2</button><button type="button" class="h-9 min-w-9 rounded-lg border border-line-300 px-2">3</button><button type="button" class="h-9 min-w-9 rounded-lg border border-line-300 px-2">4</button><button type="button" class="h-9 min-w-9 rounded-lg border border-line-300 px-2">5</button><button type="button" class="h-9 min-w-9 rounded-lg border border-line-300 px-2">»</button></nav></div>
    </div>
</section>
