@page
@model School_Library_Management.Pages.History.IndexModel
@{
    ViewData["Title"] = "Borrowing History";
    var firstPage = Math.Max(1, Model.PageIndex - 2);
    var lastPage = Math.Min(Model.TotalPages, firstPage + 4);
    firstPage = Math.Max(1, lastPage - 4);
}

<section class="space-y-5" data-ajax-table-page="history">
    <header class="page-motion page-motion-header">
        <h1 class="text-2xl font-bold tracking-tight text-ink-900 sm:text-[28px]">Borrowing History</h1>
        <p class="mt-1 text-sm text-ink-500">View and manage all borrowing records</p>
    </header>

    <div class="page-motion page-motion-filter rounded-xl border border-line-200 bg-white p-4 shadow-[0_1px_2px_rgba(16,24,40,0.03)] sm:p-5">
        <form method="get" data-ajax-table-form="history" class="flex flex-col gap-3 lg:flex-row lg:items-center" role="search">
            <div class="relative min-w-0 flex-1"><label asp-for="Search" class="sr-only">Search borrowing records</label><input asp-for="Search" placeholder="Search by loan ID, member or book..." class="min-h-10 w-full rounded-lg border border-line-300 bg-white py-2 pl-3.5 pr-10 text-sm text-ink-900 placeholder:text-ink-400 outline-none focus:border-brand-600 focus:ring-2 focus:ring-brand-600/15"/><span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-ink-400"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg></span></div>
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:flex lg:items-center">
                <div class="min-w-36"><label asp-for="Status" class="sr-only">Status</label><select asp-for="Status" data-custom-select class="min-h-10 w-full rounded-lg border border-line-300 bg-white px-3 py-2 text-sm text-ink-700"><option value="All">All Statuses</option><option value="Borrowed">Borrowed</option><option value="Returned">Returned</option><option value="Overdue">Overdue</option></select></div>
                <div class="min-w-44"><label asp-for="Period" class="sr-only">Period</label><select asp-for="Period" data-custom-select class="min-h-10 w-full rounded-lg border border-line-300 bg-white px-3 py-2 text-sm text-ink-700"><option value="ThisMonth">This Month</option><option value="LastMonth">Last Month</option><option value="ThisYear">This Year</option><option value="All">All Time</option></select></div>
                <button type="submit" class="inline-flex min-h-10 items-center justify-center gap-2 rounded-lg bg-brand-600 px-5 text-sm font-semibold text-white hover:bg-brand-700"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>Search</button>
                <a asp-page="./Index" data-ajax-table-link="history" class="inline-flex min-h-10 items-center justify-center gap-2 rounded-lg border border-line-300 bg-white px-4 text-sm font-semibold text-ink-700 hover:bg-slate-50"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>Reset</a>
            </div>
        </form>
    </div>

    <div class="page-motion page-motion-content grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <article class="flex items-center gap-4 rounded-xl border border-line-200 bg-white p-5"><span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-blue-50 text-brand-600"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg></span><div><p class="text-sm text-ink-500">Total Records</p><p class="text-2xl font-bold text-brand-600">@Model.TotalRecords</p><p class="text-xs text-ink-500">All borrowing records</p></div></article>
        <article class="flex items-center gap-4 rounded-xl border border-line-200 bg-white p-5"><span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-green-50 text-green-600"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 5h6v15H6a2 2 0 0 0-2 2V5Zm16 0h-6v15h4a2 2 0 0 1 2 2V5Z"/><circle cx="18" cy="17" r="3"/></svg></span><div><p class="text-sm text-ink-500">Borrowed</p><p class="text-2xl font-bold text-green-600">@Model.BorrowedRecords</p><p class="text-xs text-ink-500">Currently borrowed</p></div></article>
        <article class="flex items-center gap-4 rounded-xl border border-line-200 bg-white p-5"><span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-purple-50 text-purple-600"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></svg></span><div><p class="text-sm text-ink-500">Returned</p><p class="text-2xl font-bold text-purple-600">@Model.ReturnedRecords</p><p class="text-xs text-ink-500">Successfully returned</p></div></article>
        <article class="flex items-center gap-4 rounded-xl border border-line-200 bg-white p-5"><span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-red-50 text-red-600"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v6M12 17h.01"/></svg></span><div><p class="text-sm text-ink-500">Overdue</p><p class="text-2xl font-bold text-red-600">@Model.OverdueRecords</p><p class="text-xs text-ink-500">Past due date</p></div></article>
    </div>

    <div data-ajax-table-region="history" class="page-motion page-motion-table overflow-hidden rounded-xl border border-line-200 bg-white shadow-[0_1px_2px_rgba(16,24,40,0.03)]">
        <div class="flex items-center justify-between border-b border-line-200 px-4 py-3 sm:px-5"><h2 class="flex items-center gap-2 font-semibold text-ink-900"><svg class="h-5 w-5 text-brand-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>Borrowing Records</h2><span class="text-sm font-semibold text-brand-600">@Model.FilteredCount record@(Model.FilteredCount == 1 ? "" : "s")</span></div>
        <div class="overflow-x-auto"><table class="w-full min-w-275 text-left text-sm"><thead class="bg-slate-50 text-xs font-semibold uppercase tracking-wide text-ink-500"><tr><th class="px-4 py-3">Loan ID</th><th class="px-4 py-3">Member Name</th><th class="px-4 py-3">Book Title</th><th class="px-4 py-3">Borrow Date</th><th class="px-4 py-3">Due Date</th><th class="px-4 py-3">Return Date</th><th class="px-4 py-3">Status</th><th class="px-4 py-3">Fine</th><th class="px-4 py-3 text-center">Action</th></tr></thead><tbody class="divide-y divide-line-200">
        @foreach (var item in Model.Records)
        {
            var statusClass = item.Status switch { "Returned" => "bg-green-50 text-green-700", "Borrowed" => "bg-amber-50 text-amber-700", _ => "bg-red-50 text-red-700" };
            <tr class="text-ink-700 hover:bg-slate-50/70"><td class="whitespace-nowrap px-4 py-3 font-semibold text-ink-900">@item.LoanId</td><td class="whitespace-nowrap px-4 py-3">@item.MemberName</td><td class="whitespace-nowrap px-4 py-3">@item.BookTitle</td><td class="whitespace-nowrap px-4 py-3">@item.BorrowDate.ToString("MMM dd, yyyy")</td><td class="whitespace-nowrap px-4 py-3">@item.DueDate.ToString("MMM dd, yyyy")</td><td class="whitespace-nowrap px-4 py-3">@(item.ReturnDate?.ToString("MMM dd, yyyy") ?? "—")</td><td class="px-4 py-3"><span class="rounded-md px-2.5 py-1 text-xs font-semibold @statusClass">@item.Status</span></td><td class="whitespace-nowrap px-4 py-3">@item.FineAmount.ToString("N0") MMK</td><td class="px-4 py-3 text-center"><a asp-page="./Index" asp-route-search="@item.LoanId" asp-route-period="All" class="rounded-md border border-brand-600 px-3 py-1 text-xs font-semibold text-brand-600 hover:bg-blue-50">View</a></td></tr>
        }
        @if (Model.Records.Count == 0) { <tr><td colspan="9" class="px-5 py-12 text-center text-ink-500">No borrowing records match these filters.</td></tr> }
        </tbody></table></div>
        <div class="flex flex-col gap-3 border-t border-line-200 px-5 py-3 text-sm text-ink-500 sm:flex-row sm:items-center sm:justify-between">
            <span>Showing @Model.FirstRecord to @Model.LastRecord of @Model.FilteredCount records</span>
            @if (Model.TotalPages > 1)
            {
                <nav data-ajax-pagination class="flex flex-wrap gap-2" aria-label="Borrowing record pages">
                    <a asp-page="./Index" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-period="@Model.Period" asp-route-pageIndex="1" class="inline-flex h-9 min-w-9 items-center justify-center rounded-lg border border-line-300 px-2">«</a>
                    <a asp-page="./Index" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-period="@Model.Period" asp-route-pageIndex="@Math.Max(1, Model.PageIndex - 1)" class="inline-flex h-9 min-w-9 items-center justify-center rounded-lg border border-line-300 px-2">‹</a>
                    @for (var pageNumber = firstPage; pageNumber <= lastPage; pageNumber++)
                    {
                        <a asp-page="./Index" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-period="@Model.Period" asp-route-pageIndex="@pageNumber" aria-current="@(pageNumber == Model.PageIndex ? "page" : null)" class="inline-flex h-9 min-w-9 items-center justify-center rounded-lg px-2 font-semibold @(pageNumber == Model.PageIndex ? "bg-brand-600 text-white" : "border border-line-300")">@pageNumber</a>
                    }
                    <a asp-page="./Index" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-period="@Model.Period" asp-route-pageIndex="@Math.Min(Model.TotalPages, Model.PageIndex + 1)" class="inline-flex h-9 min-w-9 items-center justify-center rounded-lg border border-line-300 px-2">›</a>
                    <a asp-page="./Index" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-period="@Model.Period" asp-route-pageIndex="@Model.TotalPages" class="inline-flex h-9 min-w-9 items-center justify-center rounded-lg border border-line-300 px-2">»</a>
                </nav>
            }
        </div>
    </div>
</section>
