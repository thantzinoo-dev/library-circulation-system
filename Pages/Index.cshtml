@page
@model School_Library_Management.Pages.IndexModel
@{
    ViewData["Title"] = "Explore the Library";
    Layout = "_PublicLayout";
    var firstVisiblePage = Math.Max(1, Model.PageIndex - 2);
    var lastVisiblePage = Math.Min(Model.TotalPages, firstVisiblePage + 4);
    firstVisiblePage = Math.Max(1, lastVisiblePage - 4);
}

<section class="public-hero overflow-hidden border-b border-line-200">
    <div class="mx-auto grid max-w-[1440px] gap-10 px-4 py-14 sm:px-6 sm:py-18 lg:grid-cols-[minmax(0,1.2fr)_minmax(20rem,0.8fr)] lg:items-center lg:px-8 lg:py-22">
        <div class="max-w-3xl">
            <span class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50 px-3 py-1 text-xs font-semibold text-brand-700">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                Your library, always within reach
            </span>
            <h1 class="mt-5 text-4xl font-bold leading-[1.08] tracking-[-0.035em] text-ink-900 sm:text-5xl lg:text-[3.5rem]">
                Find your next great read.
            </h1>
            <p class="mt-5 max-w-2xl text-base leading-7 text-ink-500 sm:text-lg">
                Search the Agile Based Library collection, check live availability, and borrow a book in a few simple steps—no account required.
            </p>

            <form method="get" asp-page="/Index" asp-fragment="books" class="mt-8 flex max-w-2xl flex-col gap-2 rounded-xl border border-line-300 bg-white p-2 shadow-[0_18px_45px_-24px_rgba(15,23,42,0.35)] sm:flex-row" role="search">
                <label asp-for="Search" class="sr-only">Search books</label>
                <span class="relative min-w-0 flex-1">
                    <svg class="pointer-events-none absolute left-3.5 top-1/2 h-5 w-5 -translate-y-1/2 text-ink-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" />
                    </svg>
                    <input asp-for="Search"
                           class="min-h-11 w-full rounded-lg border-0 bg-transparent py-2.5 pl-11 pr-3 text-sm text-ink-900 outline-none placeholder:text-ink-400 focus:ring-0"
                           placeholder="Search by title, author, ISBN, or category" />
                </span>
                <button type="submit" class="inline-flex min-h-11 items-center justify-center rounded-lg bg-brand-600 px-6 text-sm font-semibold text-white transition-colors hover:bg-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600/30">
                    Search Books
                </button>
            </form>

            <div class="mt-6 flex flex-wrap gap-x-8 gap-y-3 text-sm text-ink-500">
                <span><strong class="text-ink-900">@Model.TotalTitles</strong> titles in the catalog</span>
                <span><strong class="text-ink-900">@Model.AvailableTitles</strong> available to borrow</span>
                <span><strong class="text-ink-900">7 days</strong> standard loan period</span>
            </div>
        </div>

        <div class="public-hero-art relative hidden min-h-[21rem] lg:block" aria-hidden="true">
            <div class="absolute inset-5 rounded-[2rem] bg-brand-600/10 blur-2xl"></div>
            <div class="absolute left-[8%] top-[7%] flex h-72 w-44 -rotate-6 flex-col rounded-2xl bg-brand-700 p-5 text-white shadow-2xl">
                <svg class="h-10 w-10" viewBox="0 0 48 48" fill="none"><path d="M5 8.5h13.5A5.5 5.5 0 0 1 24 14v25c-2.6-3-6.2-4.5-10.8-4.5H5v-26ZM43 8.5H29.5A5.5 5.5 0 0 0 24 14v25c2.6-3 6.2-4.5 10.8-4.5H43v-26Z" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round" /></svg>
                <div class="mt-auto">
                    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-white/65">Agile Based</p>
                    <p class="mt-2 text-[1.65rem] font-bold leading-[1.08]">Stories for every curious mind.</p>
                </div>
            </div>
            <div class="absolute bottom-[6%] right-[5%] h-64 w-44 rotate-6 rounded-2xl border border-line-200 bg-white p-5 shadow-2xl">
                <span class="flex h-10 w-10 items-center justify-center rounded-full bg-emerald-50 text-emerald-600">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m5 12 4 4L19 6" /></svg>
                </span>
                <p class="mt-16 text-xs font-semibold uppercase tracking-[0.2em] text-ink-400">Simple borrowing</p>
                <p class="mt-2 text-xl font-bold leading-tight text-ink-900">Choose a book. Borrow as a guest.</p>
            </div>
        </div>
    </div>
</section>

<section id="books" class="scroll-mt-28">
    <div class="mx-auto max-w-[1440px] px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
        <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
            <div>
                <p class="text-sm font-semibold text-brand-600">Library catalog</p>
                <h2 class="mt-1 text-2xl font-bold tracking-tight text-ink-900 sm:text-3xl">Browse books</h2>
                <p class="mt-2 text-sm text-ink-500">
                    @if (string.IsNullOrWhiteSpace(Model.Search) && string.IsNullOrWhiteSpace(Model.Category))
                    {
                        <span>Explore all @Model.TotalTitles titles currently in the collection.</span>
                    }
                    else
                    {
                        <span>
                            @Model.FilteredTitles result@(Model.FilteredTitles == 1 ? "" : "s")
                            @if (!string.IsNullOrWhiteSpace(Model.Search))
                            {
                                <text> for “@Model.Search”</text>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.Category))
                            {
                                <text> in @Model.Category</text>
                            }.
                        </span>
                    }
                </p>
            </div>

            <form method="get" asp-page="/Index" asp-fragment="books" class="public-panel flex w-full flex-col gap-2 rounded-xl border border-line-200 bg-white p-2 shadow-[0_1px_2px_rgba(16,24,40,0.04)] sm:flex-row lg:w-auto" aria-label="Filter books by category">
                @if (!string.IsNullOrWhiteSpace(Model.Search))
                {
                    <input type="hidden" name="Search" value="@Model.Search" />
                }
                <label asp-for="Category" class="sr-only">Book category</label>
                <div class="w-full sm:w-64">
                    <select asp-for="Category" data-custom-select class="min-h-10 w-full rounded-lg border border-line-300 bg-white px-3 text-sm font-medium text-ink-700 outline-none focus:border-brand-600 focus:ring-2 focus:ring-brand-600/15">
                        <option value="">All categories</option>
                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category">@category</option>
                        }
                    </select>
                </div>
                <button type="submit" class="inline-flex min-h-10 items-center justify-center gap-2 rounded-lg bg-brand-600 px-4 text-sm font-semibold text-white transition-colors hover:bg-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600/30">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M4 5h16M7 12h10M10 19h4" />
                    </svg>
                    Filter
                </button>
                @if (!string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.Category))
                {
                    <a asp-page="/Index" asp-fragment="books" class="inline-flex min-h-10 items-center justify-center rounded-lg border border-line-300 bg-white px-4 text-sm font-semibold text-ink-700 transition-colors hover:bg-slate-50">
                        Clear
                    </a>
                }
            </form>
        </div>

        @if (Model.Books.Count == 0)
        {
            <div class="mt-8 rounded-2xl border border-dashed border-line-300 bg-white px-6 py-16 text-center">
                <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-blue-50 text-brand-600">
                    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></svg>
                </span>
                <h3 class="mt-4 text-base font-semibold text-ink-900">No books found</h3>
                <p class="mt-1 text-sm text-ink-500">Try a different title, author, ISBN, or category.</p>
            </div>
        }
        else
        {
            <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                @foreach (var book in Model.Books)
                {
                    var isAvailable = book.AvailableCopies > 0;
                    <article class="public-book-card group flex min-w-0 flex-col overflow-hidden rounded-2xl border border-line-200 bg-white shadow-[0_1px_2px_rgba(16,24,40,0.04)] transition-[transform,box-shadow,border-color] duration-200 hover:-translate-y-1 hover:border-line-300 hover:shadow-[0_18px_35px_-22px_rgba(15,23,42,0.4)]">
                        <div class="relative flex h-56 items-center justify-center overflow-hidden bg-slate-100 p-5">
                            @if (!string.IsNullOrWhiteSpace(book.CoverImagePath))
                            {
                                <img src="@book.CoverImagePath" alt="Cover of @book.Title" loading="lazy" decoding="async" class="h-full max-w-full rounded-md object-contain shadow-[0_12px_25px_-12px_rgba(15,23,42,0.55)] transition-transform duration-300 group-hover:scale-[1.03]" />
                            }
                            else
                            {
                                <span class="flex h-36 w-24 items-center justify-center rounded-md bg-brand-600 text-xl font-bold text-white shadow-lg">@book.Initials</span>
                            }
                            <span class="absolute right-3 top-3 rounded-full px-2.5 py-1 text-xs font-semibold @(isAvailable ? "bg-emerald-50 text-emerald-700" : "bg-rose-50 text-rose-700")">
                                @(isAvailable ? $"{book.AvailableCopies} available" : "Unavailable")
                            </span>
                        </div>
                        <div class="flex flex-1 flex-col p-5">
                            <div class="flex items-center justify-between gap-3 text-xs text-ink-500">
                                <span class="truncate rounded-full bg-blue-50 px-2.5 py-1 font-medium text-brand-700">@book.Category</span>
                                <span>@book.PublishedYear</span>
                            </div>
                            <h3 class="mt-3 line-clamp-2 text-base font-semibold leading-6 text-ink-900" title="@book.Title">@book.Title</h3>
                            <p class="mt-1 truncate text-sm text-ink-500" title="@book.Author">@book.Author</p>
                            @if (!string.IsNullOrWhiteSpace(book.Isbn))
                            {
                                <p class="mt-2 text-xs text-ink-400">ISBN @book.Isbn</p>
                            }
                            <div class="mt-auto pt-5">
                                @if (isAvailable)
                                {
                                    <a asp-page="/Public/Borrow" asp-route-bookId="@book.Id" class="inline-flex min-h-10 w-full items-center justify-center gap-2 rounded-lg bg-brand-600 px-4 text-sm font-semibold text-white transition-colors hover:bg-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600/30">
                                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
                                        Borrow Book
                                    </a>
                                }
                                else
                                {
                                    <button type="button" disabled class="inline-flex min-h-10 w-full cursor-not-allowed items-center justify-center rounded-lg border border-line-300 bg-slate-100 px-4 text-sm font-semibold text-ink-400">
                                        Unavailable
                                    </button>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>

            <div class="public-panel mt-8 flex flex-col gap-4 rounded-xl border border-line-200 bg-white px-5 py-4 shadow-[0_1px_2px_rgba(16,24,40,0.04)] sm:flex-row sm:items-center sm:justify-between">
                <p class="text-sm text-ink-500">
                    Showing <span class="font-medium text-ink-900">@Model.StartItem</span>
                    to <span class="font-medium text-ink-900">@Model.EndItem</span>
                    of <span class="font-medium text-ink-900">@Model.FilteredTitles</span> books
                </p>

                @if (Model.TotalPages > 1)
                {
                    <nav class="flex flex-wrap items-center gap-1" aria-label="Book catalog pages">
                        <a asp-page="/Index" asp-route-Search="@Model.Search" asp-route-Category="@Model.Category" asp-route-PageIndex="1" asp-fragment="books"
                           class="inline-flex h-9 min-w-9 items-center justify-center rounded-lg border border-line-300 bg-white px-2 text-sm font-semibold text-ink-700 transition-colors hover:bg-slate-50 @(!Model.HasPreviousPage ? "pointer-events-none opacity-40" : null)"
                           aria-label="First page" aria-disabled="@(!Model.HasPreviousPage)">«</a>
                        <a asp-page="/Index" asp-route-Search="@Model.Search" asp-route-Category="@Model.Category" asp-route-PageIndex="@Math.Max(1, Model.PageIndex - 1)" asp-fragment="books"
                           class="inline-flex h-9 min-w-9 items-center justify-center rounded-lg border border-line-300 bg-white px-2 text-sm font-semibold text-ink-700 transition-colors hover:bg-slate-50 @(!Model.HasPreviousPage ? "pointer-events-none opacity-40" : null)"
                           aria-label="Previous page" aria-disabled="@(!Model.HasPreviousPage)">‹</a>

                        @for (var pageNumber = firstVisiblePage; pageNumber <= lastVisiblePage; pageNumber++)
                        {
                            <a asp-page="/Index" asp-route-Search="@Model.Search" asp-route-Category="@Model.Category" asp-route-PageIndex="@pageNumber" asp-fragment="books"
                               aria-current="@(pageNumber == Model.PageIndex ? "page" : null)"
                               class="inline-flex h-9 min-w-9 items-center justify-center rounded-lg px-2 text-sm font-semibold transition-colors @(pageNumber == Model.PageIndex ? "bg-brand-600 text-white" : "border border-line-300 bg-white text-ink-700 hover:bg-slate-50")">
                                @pageNumber
                            </a>
                        }

                        <a asp-page="/Index" asp-route-Search="@Model.Search" asp-route-Category="@Model.Category" asp-route-PageIndex="@Math.Min(Model.TotalPages, Model.PageIndex + 1)" asp-fragment="books"
                           class="inline-flex h-9 min-w-9 items-center justify-center rounded-lg border border-line-300 bg-white px-2 text-sm font-semibold text-ink-700 transition-colors hover:bg-slate-50 @(!Model.HasNextPage ? "pointer-events-none opacity-40" : null)"
                           aria-label="Next page" aria-disabled="@(!Model.HasNextPage)">›</a>
                        <a asp-page="/Index" asp-route-Search="@Model.Search" asp-route-Category="@Model.Category" asp-route-PageIndex="@Model.TotalPages" asp-fragment="books"
                           class="inline-flex h-9 min-w-9 items-center justify-center rounded-lg border border-line-300 bg-white px-2 text-sm font-semibold text-ink-700 transition-colors hover:bg-slate-50 @(!Model.HasNextPage ? "pointer-events-none opacity-40" : null)"
                           aria-label="Last page" aria-disabled="@(!Model.HasNextPage)">»</a>
                    </nav>
                }
            </div>
        }
    </div>
</section>
