@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-3xl font-bold text-red-700">Error</h1>
<p class="mt-3 text-ink-700">An error occurred while processing your request.</p>

@if (Model.ShowRequestId)
{
    <p class="mt-3 text-ink-700">
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}
