@page
@model School_Library_Management.Pages.Members.CreateModel
@{
    ViewData["Title"] = "Add New Member";
}

<section class="mx-auto max-w-4xl space-y-6">
    <div class="page-motion page-motion-header">
        <a asp-page="./Index" class="inline-flex items-center gap-1.5 text-sm font-medium text-ink-500 hover:text-brand-600 transition-colors">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
            Back to members
        </a>
        <h1 class="mt-3 text-2xl font-bold tracking-tight text-ink-900 sm:text-[28px]">Add New Member</h1>
        <p class="mt-1 text-sm text-ink-500">Enter member details and membership classification.</p>
    </div>

    <form method="post" class="page-motion page-motion-content rounded-xl border border-line-200 bg-white shadow-[0_1px_2px_rgba(16,24,40,0.03)]">
        <div class="border-b border-line-200 px-5 py-4 sm:px-6">
            <h2 class="font-semibold text-ink-900">Member Information</h2>
            <p class="mt-1 text-sm text-ink-500">Student ID is required and must be unique.</p>
        </div>

        <div class="space-y-5 p-5 sm:p-6">
            <div asp-validation-summary="ModelOnly" class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800 empty:hidden" role="alert"></div>

            <div class="grid gap-5 sm:grid-cols-2">
                <div>
                    <label asp-for="Input.StudentId" class="mb-1.5 block text-sm font-semibold text-ink-700">Student ID <span class="text-red-500">*</span></label>
                    <input asp-for="Input.StudentId"
                           class="min-h-10 w-full rounded-lg border border-line-300 px-3 py-2 text-sm outline-none focus:border-brand-600 focus:ring-2 focus:ring-brand-600/15"
                           placeholder="e.g. STU001"
                           autofocus />
                    <span asp-validation-for="Input.StudentId" class="mt-1 block text-sm text-red-600"></span>
                </div>

                <div>
                    <label asp-for="Input.Name" class="mb-1.5 block text-sm font-semibold text-ink-700">Full Name <span class="text-red-500">*</span></label>
                    <input asp-for="Input.Name"
                           class="min-h-10 w-full rounded-lg border border-line-300 px-3 py-2 text-sm outline-none focus:border-brand-600 focus:ring-2 focus:ring-brand-600/15"
                           placeholder="e.g. Aung Min Thant" />
                    <span asp-validation-for="Input.Name" class="mt-1 block text-sm text-red-600"></span>
                </div>

                <div>
                    <label asp-for="Input.MembershipType" class="mb-1.5 block text-sm font-semibold text-ink-700">Membership Type <span class="text-red-500">*</span></label>
                    <select asp-for="Input.MembershipType"
                            data-custom-select
                            class="min-h-10 w-full rounded-lg border border-line-300 bg-white px-3 py-2 text-sm text-ink-700 outline-none hover:border-line-400 focus:border-brand-600 focus:ring-2 focus:ring-brand-600/15">
                        <option value="Student">Student</option>
                        <option value="Teacher">Teacher</option>
                        <option value="Staff">Staff</option>
                    </select>
                    <span asp-validation-for="Input.MembershipType" class="mt-1 block text-sm text-red-600"></span>
                </div>

                <div>
                    <label asp-for="Input.Department" class="mb-1.5 block text-sm font-semibold text-ink-700">Department <span class="font-normal text-ink-400">(optional)</span></label>
                    <input asp-for="Input.Department"
                           class="min-h-10 w-full rounded-lg border border-line-300 px-3 py-2 text-sm outline-none focus:border-brand-600 focus:ring-2 focus:ring-brand-600/15"
                           placeholder="e.g. Computer Science" />
                    <span asp-validation-for="Input.Department" class="mt-1 block text-sm text-red-600"></span>
                </div>

                <div>
                    <label asp-for="Input.Phone" class="mb-1.5 block text-sm font-semibold text-ink-700">Phone <span class="font-normal text-ink-400">(optional)</span></label>
                    <input asp-for="Input.Phone"
                           class="min-h-10 w-full rounded-lg border border-line-300 px-3 py-2 text-sm outline-none focus:border-brand-600 focus:ring-2 focus:ring-brand-600/15"
                           placeholder="e.g. 09 250 123 456" />
                    <span asp-validation-for="Input.Phone" class="mt-1 block text-sm text-red-600"></span>
                </div>

                <div>
                    <label asp-for="Input.Email" class="mb-1.5 block text-sm font-semibold text-ink-700">Email <span class="font-normal text-ink-400">(optional)</span></label>
                    <input asp-for="Input.Email"
                           type="email"
                           class="min-h-10 w-full rounded-lg border border-line-300 px-3 py-2 text-sm outline-none focus:border-brand-600 focus:ring-2 focus:ring-brand-600/15"
                           placeholder="e.g. aungminthant@gmail.com" />
                    <span asp-validation-for="Input.Email" class="mt-1 block text-sm text-red-600"></span>
                </div>

                <div class="sm:col-span-2 pt-2">
                    <div class="flex items-center gap-3">
                        <input asp-for="Input.IsActive"
                               type="checkbox"
                               class="login-checkbox h-5 w-5 rounded border-line-300 text-brand-600 focus:ring-brand-600/20" />
                        <label asp-for="Input.IsActive" class="text-sm font-medium text-ink-900 cursor-pointer">
                            Active member (allowed to borrow books)
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex flex-col-reverse gap-3 border-t border-line-200 bg-slate-50/70 px-5 py-4 sm:flex-row sm:justify-end sm:px-6">
            <a asp-page="./Index" class="inline-flex min-h-10 items-center justify-center rounded-lg border border-line-300 bg-white px-4 text-sm font-semibold text-ink-700 hover:bg-slate-50">Cancel</a>
            <button type="submit" class="min-h-10 rounded-lg bg-brand-600 px-5 text-sm font-semibold text-white hover:bg-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600/30">Add Member</button>
        </div>
    </form>
</section>
