@page
@model School_Library_Management.Pages.Members.IndexModel
@{
    ViewData["Title"] = "Members";
    var hasActiveFilters = !string.IsNullOrWhiteSpace(Model.Search) ||
                           (!string.IsNullOrWhiteSpace(Model.Status) && !Model.Status.Equals("All", StringComparison.OrdinalIgnoreCase)) ||
                           (!string.IsNullOrWhiteSpace(Model.MembershipType) && !Model.MembershipType.Equals("All", StringComparison.OrdinalIgnoreCase));
}

<section class="space-y-5" data-ajax-table-page="members">
    <!-- Header -->
    <div class="page-motion page-motion-header flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-ink-900 sm:text-[28px]">Members</h1>
            <p class="mt-1 text-sm text-ink-500">Manage all library members</p>
        </div>

        <a asp-page="./Create"
           class="inline-flex min-h-10 items-center justify-center gap-2 rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600/30">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                <path d="M12 5v14M5 12h14" />
            </svg>
            <span>Add New Member</span>
        </a>
    </div>

    <!-- Search and Filters -->
    <div class="page-motion page-motion-filter rounded-xl border border-line-200 bg-white p-4 sm:p-5 shadow-[0_1px_2px_rgba(16,24,40,0.03)]">
        <form method="get" data-ajax-table-form="members" class="flex flex-col gap-3 lg:flex-row lg:items-center" role="search">
            <div class="relative min-w-0 flex-1">
                <label asp-for="Search" class="sr-only">Search by name, student ID, email or phone</label>
                <input asp-for="Search"
                       class="min-h-10 w-full rounded-lg border border-line-300 bg-white py-2 pl-3.5 pr-10 text-sm text-ink-900 placeholder:text-ink-400 outline-none focus:border-brand-600 focus:ring-2 focus:ring-brand-600/15"
                       placeholder="Search by name, student ID, email or phone..." />
                <span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-ink-400">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="7" />
                        <path d="m20 20-4-4" />
                    </svg>
                </span>
            </div>

            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:flex lg:items-center">
                <div class="min-w-36">
                    <label asp-for="Status" class="sr-only">Filter by status</label>
                    <select asp-for="Status"
                            data-custom-select
                            class="min-h-10 w-full rounded-lg border border-line-300 bg-white px-3 py-2 text-sm text-ink-700 outline-none hover:border-line-400 focus:border-brand-600 focus:ring-2 focus:ring-brand-600/15">
                        <option value="">All Status</option>
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                </div>

                <div class="min-w-44">
                    <label asp-for="MembershipType" class="sr-only">Filter by membership type</label>
                    <select asp-for="MembershipType"
                            data-custom-select
                            class="min-h-10 w-full rounded-lg border border-line-300 bg-white px-3 py-2 text-sm text-ink-700 outline-none hover:border-line-400 focus:border-brand-600 focus:ring-2 focus:ring-brand-600/15">
                        <option value="">All Types</option>
                        <option value="Student">Student</option>
                        <option value="Teacher">Teacher</option>
                        <option value="Staff">Staff</option>
                    </select>
                </div>

                <button type="submit"
                        class="inline-flex min-h-10 items-center justify-center gap-2 rounded-lg bg-brand-600 px-5 text-sm font-semibold text-white transition-colors hover:bg-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600/30">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="7" />
                        <path d="m20 20-4-4" />
                    </svg>
                    <span>Search</span>
                </button>

                <a asp-page="./Index" data-ajax-table-link="members"
                   class="inline-flex min-h-10 items-center justify-center gap-2 rounded-lg border border-line-300 bg-white px-4 text-sm font-semibold text-ink-700 transition-colors hover:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600/30">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
                        <path d="M3 3v5h5" />
                    </svg>
                    <span>Reset</span>
                </a>
            </div>
        </form>
    </div>

    <!-- Table Container -->
    <div data-ajax-table-region="members" class="page-motion page-motion-table rounded-xl border border-line-200 bg-white shadow-[0_1px_2px_rgba(16,24,40,0.03)] overflow-hidden">
        @if (Model.Members.Count == 0)
        {
            <div class="flex min-h-72 flex-col items-center justify-center px-6 py-12 text-center">
                <span class="flex h-12 w-12 items-center justify-center rounded-full bg-blue-50 text-brand-600" aria-hidden="true">
                    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="9" cy="8" r="3" />
                        <path d="M3.5 20v-1.5A4.5 4.5 0 0 1 8 14h2a4.5 4.5 0 0 1 4.5 4.5V20" />
                        <path d="M15.5 5.4a3 3 0 0 1 0 5.2M17 14a4.5 4.5 0 0 1 3.5 4.4V20" />
                    </svg>
                </span>
                @if (hasActiveFilters)
                {
                    <h2 class="mt-4 text-base font-semibold text-ink-900">No members match your search.</h2>
                    <p class="mt-1 text-sm text-ink-500">Try adjusting your filters or search terms.</p>
                    <a asp-page="./Index" data-ajax-table-link="members" class="mt-4 inline-flex min-h-9 items-center justify-center rounded-lg border border-line-300 bg-white px-4 text-sm font-semibold text-ink-700 hover:bg-slate-50">
                        Reset filters
                    </a>
                }
                else
                {
                    <h2 class="mt-4 text-base font-semibold text-ink-900">No members found</h2>
                    <p class="mt-1 text-sm text-ink-500">Add your first library member to get started.</p>
                    <a asp-page="./Create" class="mt-4 inline-flex min-h-9 items-center justify-center gap-2 rounded-lg bg-brand-600 px-4 text-sm font-semibold text-white hover:bg-brand-700">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14" /></svg>
                        <span>Add New Member</span>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-[13px]">
                    <thead class="border-b border-line-200 bg-slate-50/70 text-xs font-semibold uppercase tracking-wider text-ink-500">
                        <tr>
                            <th class="whitespace-nowrap px-2 py-3 text-center w-8">#</th>
                            <th class="whitespace-nowrap px-2.5 py-3">ID</th>
                            <th class="whitespace-nowrap px-2.5 py-3">Name</th>
                            <th class="whitespace-nowrap px-2.5 py-3">Email</th>
                            <th class="whitespace-nowrap px-2.5 py-3">Phone</th>
                            <th class="whitespace-nowrap px-2.5 py-3 text-center">Type</th>
                            <th class="whitespace-nowrap px-2.5 py-3">Join Date</th>
                            <th class="whitespace-nowrap px-2.5 py-3 text-center">Status</th>
                            <th class="whitespace-nowrap px-2.5 py-3 text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-line-200">
                        @for (var i = 0; i < Model.Members.Count; i++)
                        {
                            var member = Model.Members[i];
                            var rowNumber = (Model.PageIndex - 1) * School_Library_Management.Pages.Members.IndexModel.PageSize + i + 1;

                            <tr class="text-ink-700 transition-colors hover:bg-slate-50/70">
                                <td class="whitespace-nowrap px-2 py-3 text-center font-medium text-ink-500">
                                    @rowNumber
                                </td>
                                <td class="whitespace-nowrap px-2 py-3 font-semibold text-ink-900">
                                    @member.StudentId
                                </td>
                                <td class="max-w-32.5 truncate px-2 py-3 font-medium text-ink-900" title="@member.Name">
                                    @member.Name
                                </td>
                                <td class="max-w-37.5 truncate px-2 py-3 text-ink-500" title="@(member.Email ?? "—")">
                                    @(member.Email ?? "—")
                                </td>
                                <td class="whitespace-nowrap px-2 py-3 text-ink-500">
                                    @(member.Phone ?? "—")
                                </td>
                                <td class="whitespace-nowrap px-2 py-3 text-center">
                                    @if (member.MembershipType == School_Library_Management.Models.MemberType.Teacher)
                                    {
                                        <span class="inline-flex rounded-md border border-purple-200/60 bg-purple-50 px-2 py-0.5 text-xs font-semibold text-purple-700">Teacher</span>
                                    }
                                    else if (member.MembershipType == School_Library_Management.Models.MemberType.Staff)
                                    {
                                        <span class="inline-flex rounded-md border border-teal-200/60 bg-teal-50 px-2 py-0.5 text-xs font-semibold text-teal-700">Staff</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex rounded-md border border-blue-200/60 bg-blue-50 px-2 py-0.5 text-xs font-semibold text-brand-600">Student</span>
                                    }
                                </td>
                                <td class="whitespace-nowrap px-2 py-3 text-ink-500">
                                    @member.CreatedAt.ToString("MMM dd, yyyy")
                                </td>
                                <td class="whitespace-nowrap px-2 py-3 text-center">
                                    @if (member.IsActive)
                                    {
                                        <span class="inline-flex rounded-md border border-emerald-200/60 bg-emerald-50 px-2 py-0.5 text-xs font-semibold text-emerald-700">Active</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex rounded-md border border-rose-200/60 bg-rose-50 px-2 py-0.5 text-xs font-semibold text-rose-700">Inactive</span>
                                    }
                                </td>
                                <td class="whitespace-nowrap px-2 py-3 text-center">
                                    <div class="flex items-center justify-center gap-1.5">
                                        <!-- View -->
                                        <button type="button"
                                                class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-blue-300 text-brand-600 transition-colors hover:bg-blue-50 active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600/30"
                                                data-view-member
                                                data-member-id="@member.Id"
                                                data-member-name="@member.Name"
                                                data-student-id="@member.StudentId"
                                                data-membership-type="@member.MembershipType"
                                                data-email="@(member.Email ?? "—")"
                                                data-phone="@(member.Phone ?? "—")"
                                                data-department="@(member.Department ?? "—")"
                                                data-join-date="@member.CreatedAt.ToString("MMMM dd, yyyy")"
                                                data-status="@(member.IsActive ? "Active" : "Inactive")"
                                                data-borrows="@member.BorrowCount"
                                                data-active-borrows="@member.ActiveBorrowCount"
                                                title="View member details"
                                                aria-label="View member details for @member.Name">
                                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
                                                <circle cx="12" cy="12" r="3" />
                                            </svg>
                                        </button>

                                        <!-- Edit -->
                                        <a asp-page="./Edit" asp-route-id="@member.Id"
                                           class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-amber-300 text-amber-600 transition-colors hover:bg-amber-50 active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-500/30"
                                           title="Edit member"
                                           aria-label="Edit @member.Name">
                                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" />
                                            </svg>
                                        </a>

                                        <!-- Delete -->
                                        <form method="post" asp-page-handler="Delete" asp-route-id="@member.Id" class="inline"
                                              data-confirm-form
                                              data-confirm-title="Delete member?"
                                              data-confirm-description="Delete “@member.Name” (@member.StudentId)? This action cannot be undone."
                                              data-confirm-action="Delete member">
                                            <input type="hidden" name="Search" value="@Model.Search" />
                                            <input type="hidden" name="Status" value="@Model.Status" />
                                            <input type="hidden" name="MembershipType" value="@Model.MembershipType" />
                                            <input type="hidden" name="PageIndex" value="@Model.PageIndex" />
                                            <button type="submit"
                                                    class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-red-300 text-red-600 transition-colors hover:bg-red-50 active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500/30"
                                                    title="Delete member"
                                                    aria-label="Delete @member.Name">
                                                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                    <path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                                                    <line x1="10" y1="11" x2="10" y2="17" />
                                                    <line x1="14" y1="11" x2="14" y2="17" />
                                                </svg>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Footer / Pagination -->
            <div class="flex flex-col gap-4 border-t border-line-200 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
                <p class="text-sm text-ink-500">
                    Showing <span class="font-medium text-ink-900">@Model.StartItem</span> to <span class="font-medium text-ink-900">@Model.EndItem</span> of <span class="font-medium text-ink-900">@Model.TotalItems</span> members
                </p>

                @if (Model.TotalPages > 1)
                {
                    <nav data-ajax-pagination class="flex items-center gap-1" aria-label="Pagination">
                        <!-- First -->
                        <a asp-page="./Index"
                           asp-route-PageIndex="1"
                           asp-route-Search="@Model.Search"
                           asp-route-Status="@Model.Status"
                           asp-route-MembershipType="@Model.MembershipType"
                           class="inline-flex h-8 min-w-8 items-center justify-center rounded-lg border border-line-300 bg-white px-2 text-xs font-semibold text-ink-700 transition-colors hover:bg-slate-50 @(Model.PageIndex == 1 ? "pointer-events-none opacity-40" : null)"
                           aria-label="First page"
                           title="First page">
                            «
                        </a>

                        <!-- Previous -->
                        <a asp-page="./Index"
                           asp-route-PageIndex="@(Model.PageIndex - 1)"
                           asp-route-Search="@Model.Search"
                           asp-route-Status="@Model.Status"
                           asp-route-MembershipType="@Model.MembershipType"
                           class="inline-flex h-8 min-w-8 items-center justify-center rounded-lg border border-line-300 bg-white px-2 text-xs font-semibold text-ink-700 transition-colors hover:bg-slate-50 @(!Model.HasPreviousPage ? "pointer-events-none opacity-40" : null)"
                           aria-label="Previous page"
                           title="Previous page">
                            ‹
                        </a>

                        <!-- Page numbers -->
                        @{
                            var startPage = Math.Max(1, Model.PageIndex - 2);
                            var endPage = Math.Min(Model.TotalPages, startPage + 4);
                            if (endPage - startPage < 4)
                            {
                                startPage = Math.Max(1, endPage - 4);
                            }
                        }

                        @for (var p = startPage; p <= endPage; p++)
                        {
                            var isCurrent = p == Model.PageIndex;
                            if (isCurrent)
                            {
                                <span class="inline-flex h-8 min-w-8 items-center justify-center rounded-lg bg-brand-600 px-2.5 text-xs font-bold text-white shadow-sm" aria-current="page">
                                    @p
                                </span>
                            }
                            else
                            {
                                <a asp-page="./Index"
                                   asp-route-PageIndex="@p"
                                   asp-route-Search="@Model.Search"
                                   asp-route-Status="@Model.Status"
                                   asp-route-MembershipType="@Model.MembershipType"
                                   class="inline-flex h-8 min-w-8 items-center justify-center rounded-lg border border-line-300 bg-white px-2.5 text-xs font-semibold text-ink-700 transition-colors hover:bg-slate-50">
                                    @p
                                </a>
                            }
                        }

                        <!-- Next -->
                        <a asp-page="./Index"
                           asp-route-PageIndex="@(Model.PageIndex + 1)"
                           asp-route-Search="@Model.Search"
                           asp-route-Status="@Model.Status"
                           asp-route-MembershipType="@Model.MembershipType"
                           class="inline-flex h-8 min-w-8 items-center justify-center rounded-lg border border-line-300 bg-white px-2 text-xs font-semibold text-ink-700 transition-colors hover:bg-slate-50 @(!Model.HasNextPage ? "pointer-events-none opacity-40" : null)"
                           aria-label="Next page"
                           title="Next page">
                            ›
                        </a>

                        <!-- Last -->
                        <a asp-page="./Index"
                           asp-route-PageIndex="@Model.TotalPages"
                           asp-route-Search="@Model.Search"
                           asp-route-Status="@Model.Status"
                           asp-route-MembershipType="@Model.MembershipType"
                           class="inline-flex h-8 min-w-8 items-center justify-center rounded-lg border border-line-300 bg-white px-2 text-xs font-semibold text-ink-700 transition-colors hover:bg-slate-50 @(Model.PageIndex == Model.TotalPages ? "pointer-events-none opacity-40" : null)"
                           aria-label="Last page"
                           title="Last page">
                            »
                        </a>
                    </nav>
                }
            </div>
        }
    </div>
</section>

<!-- Member Details Modal -->
<div id="member-details-modal"
     class="fixed inset-0 z-[100] flex items-center justify-center bg-slate-950/55 p-4 opacity-0 pointer-events-none backdrop-blur-[2px] transition-opacity duration-150"
     role="dialog"
     aria-modal="true"
     aria-labelledby="modal-member-name"
     inert>
    <div id="member-details-card" class="relative w-full max-w-2xl translate-y-2 scale-[0.98] overflow-hidden rounded-xl border border-line-300 bg-white shadow-[0_24px_80px_-20px_rgba(2,6,23,0.45)] transition-transform duration-150 ease-out">
        <div class="flex items-start justify-between gap-4 border-b border-line-200 px-5 py-5 sm:px-6">
            <div class="flex min-w-0 items-center gap-4">
                <span id="modal-avatar" class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-brand-600 text-xl font-bold text-white shadow-sm">M</span>
                <div class="min-w-0">
                    <div class="flex flex-wrap items-center gap-2">
                        <h3 id="modal-member-name" class="truncate text-lg font-semibold text-ink-900"></h3>
                        <span id="modal-status" class="inline-flex rounded-full px-2.5 py-1 text-xs font-semibold"></span>
                    </div>
                    <p id="modal-student-id" class="mt-1 text-sm font-semibold text-brand-600"></p>
                </div>
            </div>
            <button type="button" id="close-modal-btn" class="shrink-0 rounded-lg p-1.5 text-ink-400 transition-colors hover:bg-slate-100 hover:text-ink-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600/30" aria-label="Close member details">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
            </button>
        </div>

        <div class="space-y-5 p-5 sm:p-6">
            <section aria-labelledby="member-information-title">
                <h4 id="member-information-title" class="text-sm font-semibold text-ink-900">Member information</h4>
                <dl class="mt-3 grid overflow-hidden rounded-xl border border-line-200 sm:grid-cols-2">
                    <div class="border-b border-line-200 p-4 sm:border-r">
                        <dt class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-ink-500">
                            <svg class="h-4 w-4 text-ink-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16v16H4z"/><path d="m4 7 8 6 8-6"/></svg>
                            Email
                        </dt>
                        <dd id="modal-email" class="mt-2 truncate text-sm font-medium text-ink-900"></dd>
                    </div>
                    <div class="border-b border-line-200 p-4">
                        <dt class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-ink-500">
                            <svg class="h-4 w-4 text-ink-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.4 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/></svg>
                            Phone
                        </dt>
                        <dd id="modal-phone" class="mt-2 text-sm font-medium text-ink-900"></dd>
                    </div>
                    <div class="border-b border-line-200 p-4 sm:border-b-0 sm:border-r">
                        <dt class="text-xs font-semibold uppercase tracking-wider text-ink-500">Member type</dt>
                        <dd><span id="modal-membership-type" class="mt-2 inline-flex rounded-md px-2.5 py-1 text-xs font-semibold"></span></dd>
                    </div>
                    <div class="p-4">
                        <dt class="text-xs font-semibold uppercase tracking-wider text-ink-500">Department</dt>
                        <dd id="modal-department" class="mt-2 text-sm font-medium text-ink-900"></dd>
                    </div>
                </dl>
            </section>

            <section class="grid gap-3 sm:grid-cols-3" aria-label="Member activity summary">
                <div class="rounded-xl border border-line-200 bg-slate-50 p-4">
                    <p class="text-xs font-medium text-ink-500">Joined</p>
                    <p id="modal-join-date" class="mt-1 text-sm font-semibold text-ink-900"></p>
                </div>
                <div class="rounded-xl border border-line-200 bg-slate-50 p-4">
                    <p class="text-xs font-medium text-ink-500">Total borrowed</p>
                    <p id="modal-borrows" class="mt-1 text-xl font-bold text-ink-900">0</p>
                </div>
                <div class="rounded-xl border border-brand-600/20 bg-blue-50 p-4">
                    <p class="text-xs font-medium text-ink-500">Currently borrowed</p>
                    <p id="modal-active-borrows" class="mt-1 text-xl font-bold text-brand-600">0</p>
                </div>
            </section>
        </div>

        <div class="flex flex-col-reverse gap-2.5 border-t border-line-200 bg-slate-50/70 px-5 py-4 sm:flex-row sm:justify-end sm:px-6">
            <button type="button" id="modal-dismiss-btn" class="inline-flex min-h-10 items-center justify-center rounded-lg border border-line-300 bg-white px-5 text-sm font-semibold text-ink-700 transition-colors hover:bg-slate-50">
                Close
            </button>
            <a id="modal-edit-link" href="#" class="inline-flex min-h-10 items-center justify-center gap-2 rounded-lg bg-brand-600 px-5 text-sm font-semibold text-white transition-colors hover:bg-brand-700">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>
                Edit member
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/members.js" asp-append-version="true"></script>
}
