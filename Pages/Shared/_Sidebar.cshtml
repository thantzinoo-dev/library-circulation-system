@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
    var isBooksPage = currentPage?.StartsWith("/Books", StringComparison.OrdinalIgnoreCase) == true;
    var isMembersPage = currentPage?.StartsWith("/Members", StringComparison.OrdinalIgnoreCase) == true;
    var isBorrowPage = currentPage?.StartsWith("/Borrow", StringComparison.OrdinalIgnoreCase) == true;
    var isReturnPage = currentPage?.StartsWith("/Return", StringComparison.OrdinalIgnoreCase) == true;
    var isHistoryPage = currentPage?.StartsWith("/History", StringComparison.OrdinalIgnoreCase) == true;
    var isReportsPage = currentPage?.StartsWith("/Reports", StringComparison.OrdinalIgnoreCase) == true;
    const string navigationItemClasses = "flex h-10 w-full items-center gap-3 rounded-lg px-3 text-[15px] font-medium text-ink-700 transition-[background-color,color,padding] duration-150 ease-out hover:bg-blue-50 hover:text-brand-600 active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600/30 group-data-[collapsed=true]/sidebar:h-10 group-data-[collapsed=true]/sidebar:w-10 group-data-[collapsed=true]/sidebar:justify-center group-data-[collapsed=true]/sidebar:gap-0 group-data-[collapsed=true]/sidebar:px-0 group-data-[collapsed=true]/sidebar:mx-auto";
    const string activeNavigationItemClasses = "bg-blue-100/80 text-brand-700 font-semibold shadow-[inset_0_0_0_1px_rgba(0,72,198,0.16)]";
}

<aside id="app-sidebar"
       class="app-sidebar group/sidebar flex h-dvh w-69.5 shrink-0 flex-col border-r border-line-200 bg-white transition-[width] duration-300 ease-out data-[collapsed=true]:w-20 data-[ready=false]:transition-none"
       data-app-sidebar
       data-collapsed="false"
       data-ready="false"
       aria-label="Primary navigation">
    <div class="flex h-20 shrink-0 items-center justify-between border-b border-line-200 px-4 transition-[height,gap,padding] duration-300 ease-out group-data-[collapsed=true]/sidebar:h-auto group-data-[collapsed=true]/sidebar:flex-col group-data-[collapsed=true]/sidebar:justify-center group-data-[collapsed=true]/sidebar:gap-2.5 group-data-[collapsed=true]/sidebar:px-2 group-data-[collapsed=true]/sidebar:pt-5.5 group-data-[collapsed=true]/sidebar:pb-4" data-sidebar-brand>
        <div class="flex min-w-0 flex-1 items-center gap-3 group-data-[collapsed=true]/sidebar:flex-initial group-data-[collapsed=true]/sidebar:justify-center">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center text-brand-600 transition-[width,height] duration-300 ease-out group-data-[collapsed=true]/sidebar:h-10 group-data-[collapsed=true]/sidebar:w-10" data-sidebar-brand-mark aria-hidden="true">
                <svg class="h-10 w-10 transition-[width,height] duration-300 ease-out group-data-[collapsed=true]/sidebar:h-9 group-data-[collapsed=true]/sidebar:w-9" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M5 8.5h13.5A5.5 5.5 0 0 1 24 14v25c-2.6-3-6.2-4.5-10.8-4.5H5v-26Z"
                          stroke="currentColor" stroke-width="2.4" stroke-linejoin="round" />
                    <path d="M43 8.5H29.5A5.5 5.5 0 0 0 24 14v25c2.6-3 6.2-4.5 10.8-4.5H43v-26Z"
                          stroke="currentColor" stroke-width="2.4" stroke-linejoin="round" />
                    <path d="M10 15h7M10 20h7M31 15h7M31 20h7" stroke="currentColor" stroke-width="2"
                          stroke-linecap="round" />
                </svg>
            </span>
            <span class="sidebar-label min-w-0 flex-1 leading-tight" data-sidebar-label>
                <span class="block truncate text-[17px] font-bold text-ink-900">School Library</span>
                <span class="mt-0.5 block truncate text-[13px] text-ink-500">Management System</span>
            </span>
        </div>
        <button type="button"
                class="sidebar-toggle flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-line-300 bg-white text-ink-700 transition-[width,height,color,background-color,border-color,box-shadow] duration-200 ease-out hover:border-line-400 hover:bg-blue-50 hover:text-brand-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600/30 group-data-[collapsed=true]/sidebar:h-8 group-data-[collapsed=true]/sidebar:w-8"
                data-sidebar-toggle
                aria-controls="app-sidebar"
                aria-expanded="true"
                aria-label="Collapse sidebar"
                title="Collapse sidebar">
            <svg class="sidebar-toggle-icon h-5 w-5"
                 style="transition: transform 220ms cubic-bezier(0.16, 1, 0.3, 1); transform-origin: center center;"
                 viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m13 7-5 5 5 5M18 7l-5 5 5 5" />
            </svg>
        </button>
    </div>

    <nav class="min-h-0 flex-1 overflow-y-auto px-3 py-4 group-data-[collapsed=true]/sidebar:px-2 group-data-[collapsed=true]/sidebar:py-3.5" aria-label="Library sections">
        <ul class="space-y-1.5">
            <li>
                <a asp-page="/Index"
                   class="@navigationItemClasses @(currentPage == "/Index" ? activeNavigationItemClasses : null)"
                   aria-current="@(currentPage == "/Index" ? "page" : null)"
                   title="Dashboard">
                    <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M3.5 10.5 12 3l8.5 7.5" />
                        <path d="M5.5 9v11h13V9M9.5 20v-6h5v6" />
                    </svg>
                    <span class="sidebar-label truncate" data-sidebar-label>Dashboard</span>
                </a>
            </li>
            <li>
                <a asp-page="/Books/Index"
                   class="@navigationItemClasses @(isBooksPage ? activeNavigationItemClasses : null)"
                   aria-current="@(isBooksPage ? "page" : null)"
                   title="Books">
                    <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H11v16H6.5A2.5 2.5 0 0 0 4 21.5v-16Z" />
                        <path d="M20 5.5A2.5 2.5 0 0 0 17.5 3H13v16h4.5a2.5 2.5 0 0 1 2.5 2.5v-16Z" />
                    </svg>
                    <span class="sidebar-label truncate" data-sidebar-label>Books</span>
                </a>
            </li>
            <li>
                <a asp-page="/Members/Index"
                   class="@navigationItemClasses @(isMembersPage ? activeNavigationItemClasses : null)"
                   aria-current="@(isMembersPage ? "page" : null)"
                   title="Members">
                    <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="9" cy="8" r="3" />
                        <path d="M3.5 20v-1.5A4.5 4.5 0 0 1 8 14h2a4.5 4.5 0 0 1 4.5 4.5V20" />
                        <path d="M15.5 5.4a3 3 0 0 1 0 5.2M17 14a4.5 4.5 0 0 1 3.5 4.4V20" />
                    </svg>
                    <span class="sidebar-label truncate" data-sidebar-label>Members</span>
                </a>
            </li>
            <li>
                <a asp-page="/Borrow/Index"
                   class="@navigationItemClasses @(isBorrowPage ? activeNavigationItemClasses : null)"
                   aria-current="@(isBorrowPage ? "page" : null)"
                   title="Borrow">
                    <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="8.5" />
                        <path d="M12 8v8M8 12h8" />
                    </svg>
                    <span class="sidebar-label truncate" data-sidebar-label>Borrow</span>
                </a>
            </li>
            <li>
                <a asp-page="/Return/Index"
                   class="@navigationItemClasses @(isReturnPage ? activeNavigationItemClasses : null)"
                   aria-current="@(isReturnPage ? "page" : null)"
                   title="Return">
                    <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M4 7v5h5" />
                        <path d="M5.5 11a7 7 0 1 0 2-5" />
                    </svg>
                    <span class="sidebar-label truncate" data-sidebar-label>Return</span>
                </a>
            </li>
            <li>
                <a asp-page="/History/Index"
                   class="@navigationItemClasses @(isHistoryPage ? activeNavigationItemClasses : null)"
                   aria-current="@(isHistoryPage ? "page" : null)"
                   title="Browsing History">
                    <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="8.5" />
                        <path d="M12 7.5V12l3 2" />
                    </svg>
                    <span class="sidebar-label truncate" data-sidebar-label>Browsing History</span>
                </a>
            </li>
            <li>
                <a asp-page="/Reports/Index"
                   class="@navigationItemClasses @(isReportsPage ? activeNavigationItemClasses : null)"
                   aria-current="@(isReportsPage ? "page" : null)"
                   title="Reports">
                    <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 3.5h14v17H5z" />
                        <path d="M8.5 16v-3M12 16V8M15.5 16v-5" />
                    </svg>
                    <span class="sidebar-label truncate" data-sidebar-label>Reports</span>
                </a>
            </li>
        </ul>
    </nav>

    <div class="shrink-0 border-t border-line-200 p-3 group-data-[collapsed=true]/sidebar:px-2 group-data-[collapsed=true]/sidebar:py-3" data-account-root>
        <button id="account-menu-trigger"
                type="button"
                class="account-trigger flex min-h-14.5 w-full items-center gap-3 rounded-xl px-2.5 py-2 text-left transition-[background-color,color,gap,padding] duration-200 ease-out hover:bg-blue-50 active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600/30 group-data-[collapsed=true]/sidebar:min-h-0 group-data-[collapsed=true]/sidebar:h-10 group-data-[collapsed=true]/sidebar:w-10 group-data-[collapsed=true]/sidebar:justify-center group-data-[collapsed=true]/sidebar:gap-0 group-data-[collapsed=true]/sidebar:p-0 group-data-[collapsed=true]/sidebar:mx-auto"
                data-account-trigger
                aria-haspopup="menu"
                aria-controls="account-menu"
                aria-expanded="false">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-600 text-[15px] font-bold text-white"
                  aria-hidden="true">A</span>
            <span class="sidebar-label min-w-0 flex-1" data-sidebar-label>
                <span class="block truncate text-[14px] font-semibold text-ink-900">Admin User</span>
                <span class="mt-0.5 block truncate text-[12px] text-ink-500">Administrator</span>
            </span>
            <svg class="account-chevron sidebar-label h-4 w-4 shrink-0 text-ink-400 transition-transform duration-200"
                 data-account-chevron data-sidebar-label viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m7 14 5-5 5 5" />
            </svg>
            <span class="sr-only">Open account menu for Admin User</span>
        </button>

        <div id="account-menu"
             class="account-menu fixed z-50 max-h-[calc(100dvh-1rem)] overflow-y-auto rounded-xl border border-line-300 bg-white p-1.5 shadow-[0_12px_32px_-8px_rgba(16,24,40,0.24)]"
             data-account-menu
             data-state="closed"
             role="menu"
             aria-labelledby="account-menu-trigger"
             inert
             hidden>
            <div class="flex items-center gap-3 px-2.5 py-2.5" role="presentation">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-600 text-[15px] font-bold text-white"
                      aria-hidden="true">A</span>
                <span class="min-w-0">
                    <span class="block truncate text-[14px] font-semibold text-ink-900">Admin User</span>
                    <span class="mt-0.5 block truncate text-[12px] text-ink-500">Administrator</span>
                </span>
            </div>

            <div class="my-1 h-px bg-line-200" role="separator"></div>

            <a href="/Profile"
               class="flex min-h-10 items-center gap-3 rounded-lg px-2.5 text-[14px] text-ink-700 hover:bg-blue-50 hover:text-ink-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600/30"
               role="menuitem">
                <svg class="h-4.5 w-4.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="8" r="3.5" />
                    <path d="M5 20a7 7 0 0 1 14 0" />
                </svg>
                Profile
            </a>
            <a href="/Settings"
               class="flex min-h-10 items-center gap-3 rounded-lg px-2.5 text-[14px] text-ink-700 hover:bg-blue-50 hover:text-ink-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600/30"
               role="menuitem">
                <svg class="h-4.5 w-4.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="3" />
                    <path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-2.8 2.8-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6v.2h-4V21a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1L4.2 17l.1-.1a1.7 1.7 0 0 0 .3-1.9A1.7 1.7 0 0 0 3 14H2.8v-4H3a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9L4.2 7 7 4.2l.1.1a1.7 1.7 0 0 0 1.9.3A1.7 1.7 0 0 0 10 3V2.8h4V3a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1L19.8 7l-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.6 1h.2v4H21a1.7 1.7 0 0 0-1.6 1Z" />
                </svg>
                Settings
            </a>

            <button type="button"
                    data-theme-toggle
                    class="flex min-h-10 w-full items-center justify-between rounded-lg px-2.5 text-[14px] text-ink-700 hover:bg-blue-50 hover:text-ink-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600/30"
                    role="menuitem"
                    title="Toggle dark mode">
                <span class="flex items-center gap-3">
                    <svg class="h-4.5 w-4.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
                    </svg>
                    Dark Mode
                </span>
                <span class="theme-status-badge rounded-md bg-slate-100 px-1.5 py-0.5 text-[11px] font-semibold text-ink-500">Off</span>
            </button>

            <div class="my-1 h-px bg-line-200" role="separator"></div>

            <a asp-page="/Login"
               class="flex min-h-10 items-center gap-3 rounded-lg px-2.5 text-[14px] text-red-700 hover:bg-red-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500/30"
               role="menuitem">
                <svg class="h-4.5 w-4.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M10 5H5v14h5M14 8l4 4-4 4M8 12h10" />
                </svg>
                Log out
            </a>
        </div>
    </div>
</aside>
