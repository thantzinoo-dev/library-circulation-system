    <circle cx="351" cy="72" r="5" fill="#FFFFFF" opacity="0.30" />

    <!-- wall clock -->
    <g opacity="0.22">
        <circle cx="273" cy="50" r="47" fill="#FFFFFF" />
    </g>
    <g opacity="0.55" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round">
        <path d="M273 26v25l16 10" />
    </g>

    <!-- bookshelf -->
    <g opacity="0.30">
        <path d="M150 60h130v167H150z" fill="#FFFFFF" opacity="0.12" />
