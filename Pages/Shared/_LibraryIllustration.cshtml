        <path d="M58 96l3 4 24-9 21 8-3 5-22-6-23-2Z" fill="#FFFFFF" opacity="0.85" />
        <path d="M85 91l21 7" stroke="#0049C7" stroke-width="1.5" opacity="0.25" />
    </g>

    <!-- ---------- ground line ---------- -->
    <path d="M1 228h384" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" opacity="0.42" />
</svg>
