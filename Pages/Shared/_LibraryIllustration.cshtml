            <path d="M150 60h130v167H150z" />
            <path d="M150 112h130M150 165h130" />
        </g>
        <g fill="#FFFFFF">
            <rect x="160" y="76" width="9" height="34" rx="1.5" />
            <rect x="173" y="70" width="9" height="40" rx="1.5" />
            <rect x="186" y="80" width="9" height="30" rx="1.5" />
            <rect x="205" y="74" width="9" height="36" rx="1.5" />
            <rect x="218" y="82" width="9" height="28" rx="1.5" />
            <rect x="243" y="72" width="9" height="38" rx="1.5" />
            <rect x="256" y="79" width="9" height="31" rx="1.5" />

            <rect x="160" y="128" width="9" height="35" rx="1.5" />
            <rect x="173" y="134" width="9" height="29" rx="1.5" />
            <rect x="230" y="126" width="9" height="37" rx="1.5" />
            <rect x="243" y="132" width="9" height="31" rx="1.5" />
            <rect x="256" y="128" width="9" height="35" rx="1.5" />

            <rect x="196" y="182" width="9" height="34" rx="1.5" />
            <rect x="209" y="188" width="9" height="28" rx="1.5" />
            <rect x="222" y="180" width="9" height="36" rx="1.5" />
            <rect x="256" y="186" width="9" height="30" rx="1.5" />
        </g>
    </g>

    <!-- ---------- plant ---------- -->
    <g>
        <g opacity="0.92">
            <path d="M318 178c-14-10-22-27-20-45 16 3 30 16 33 33" fill="#FFFFFF" opacity="0.55" />
            <path d="M341 176c2-19 15-35 33-41 3 19-6 37-22 46" fill="#FFFFFF" opacity="0.80" />
            <path d="M330 180c-3-22 6-43 24-54 8 20 4 42-11 55" fill="#FFFFFF" opacity="0.95" />
        </g>
        <path d="M331 180c-1-24 4-42 13-54" stroke="#0049C7" stroke-width="2" opacity="0.35" />
        <path d="M310 182h50l-6 42a6 6 0 0 1-6 5h-26a6 6 0 0 1-6-5l-6-42Z" fill="#FFFFFF" opacity="0.75" />
        <path d="M310 182h50l-1.6 11h-46.8L310 182Z" fill="#FFFFFF" />
    </g>

    <!-- ---------- stack of books ---------- -->
    <g>
        <!-- bottom book -->
        <path d="M30 196h206l6 12-6 12H30l-6-12 6-12Z" fill="#FFFFFF" opacity="0.55" />
