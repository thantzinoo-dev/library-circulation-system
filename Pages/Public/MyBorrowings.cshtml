@page "/MyBorrowings"
@model School_Library_Management.Pages.Public.MyBorrowingsModel
@using School_Library_Management.Models
@{
    ViewData["Title"] = "My Borrowings";
    Layout = "_PublicLayout";
}

<div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <header class="max-w-2xl">
        <p class="text-sm font-semibold text-brand-600">Loan lookup</p>
        <h1 class="mt-1 text-3xl font-bold tracking-tight text-ink-900">My Borrowings</h1>
        <p class="mt-2 text-sm leading-6 text-ink-500">Enter your exact Student ID to review your library loans. No contact or membership details are displayed.</p>
    </header>

    <form method="get" class="public-panel mt-7 flex flex-col gap-3 rounded-xl border border-line-200 bg-white p-4 shadow-[0_1px_2px_rgba(16,24,40,0.04)] sm:flex-row" role="search">
        <div class="relative min-w-0 flex-1">
            <label asp-for="StudentId" class="sr-only">Student ID</label>
            <svg class="pointer-events-none absolute left-3.5 top-1/2 h-5 w-5 -translate-y-1/2 text-ink-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="m16 11 2 2 4-4" /></svg>
            <input asp-for="StudentId" maxlength="30" autocomplete="off" class="min-h-11 w-full rounded-lg border border-line-300 bg-white py-2 pl-11 pr-3 text-sm text-ink-900 outline-none placeholder:text-ink-400 focus:border-brand-600 focus:ring-2 focus:ring-brand-600/15" placeholder="Enter your Student ID" />
        </div>
        <button type="submit" class="inline-flex min-h-11 items-center justify-center rounded-lg bg-brand-600 px-6 text-sm font-semibold text-white hover:bg-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600/30">Find Borrowings</button>
    </form>

    @if (!Model.SearchPerformed)
    {
        <div class="mt-7 rounded-2xl border border-dashed border-line-300 bg-white px-6 py-14 text-center">
            <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-blue-50 text-brand-600">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
            </span>
            <h2 class="mt-4 text-base font-semibold text-ink-900">Your loan history appears here</h2>
            <p class="mt-1 text-sm text-ink-500">Search with the Student ID used when borrowing.</p>
        </div>
    }
    else if (!Model.MemberFound)
    {
        <div class="mt-7 rounded-xl border border-amber-200 bg-amber-50 px-5 py-4 text-sm text-amber-800" role="status">
            No library member was found for that Student ID. Check the ID and try again.
        </div>
    }
    else if (Model.Borrowings.Count == 0)
    {
        <div class="mt-7 rounded-xl border border-line-200 bg-white px-5 py-10 text-center">
            <h2 class="font-semibold text-ink-900">No borrowing records found</h2>
            <p class="mt-1 text-sm text-ink-500">This Student ID does not have any recorded loans yet.</p>
        </div>
    }
    else
    {
        <section class="public-panel mt-7 overflow-hidden rounded-xl border border-line-200 bg-white shadow-[0_1px_2px_rgba(16,24,40,0.04)]" aria-label="Borrowing records">
            <div class="border-b border-line-200 px-5 py-4">
                <h2 class="font-semibold text-ink-900">Borrowing records</h2>
                <p class="mt-1 text-xs text-ink-500">@Model.Borrowings.Count record@(Model.Borrowings.Count == 1 ? "" : "s") found</p>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full min-w-[780px] text-left text-sm">
                    <thead class="bg-slate-50 text-xs uppercase tracking-wide text-ink-500">
                        <tr>
                            <th class="px-5 py-3 font-semibold">Loan ID</th>
                            <th class="px-5 py-3 font-semibold">Book</th>
                            <th class="px-5 py-3 font-semibold">Borrow Date</th>
                            <th class="px-5 py-3 font-semibold">Due Date</th>
                            <th class="px-5 py-3 font-semibold">Status</th>
                            <th class="px-5 py-3 font-semibold">Time</th>
                            <th class="px-5 py-3 font-semibold">Fine</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-line-200">
                        @foreach (var item in Model.Borrowings)
                        {
                            <tr>
                                <td class="whitespace-nowrap px-5 py-4 font-semibold text-ink-700">@item.LoanId</td>
                                <td class="px-5 py-4">
                                    <div class="flex items-center gap-3">
                                        @if (!string.IsNullOrWhiteSpace(item.CoverImagePath))
                                        {
                                            <img src="@item.CoverImagePath" alt="" class="h-11 w-8 rounded object-cover shadow-sm" />
                                        }
                                        <span class="max-w-xs font-medium text-ink-900">@item.BookTitle</span>
                                    </div>
                                </td>
                                <td class="whitespace-nowrap px-5 py-4 text-ink-500">@item.BorrowDate.ToString("MMM d, yyyy")</td>
                                <td class="whitespace-nowrap px-5 py-4 text-ink-500">@item.DueDate.ToString("MMM d, yyyy")</td>
                                <td class="px-5 py-4">
                                    <span class="inline-flex rounded-full px-2.5 py-1 text-xs font-semibold @(item.Status == BorrowStatus.Returned ? "bg-emerald-50 text-emerald-700" : item.Status == BorrowStatus.Overdue ? "bg-rose-50 text-rose-700" : "bg-blue-50 text-brand-700")">@item.Status</span>
                                </td>
                                <td class="whitespace-nowrap px-5 py-4 text-sm @(item.Status == BorrowStatus.Overdue ? "font-semibold text-rose-600" : "text-ink-500")">
                                    @if (item.Status == BorrowStatus.Returned)
                                    {
                                        <span>Returned @item.ReturnDate!.Value.ToString("MMM d")</span>
                                    }
                                    else if (item.DayDifference < 0)
                                    {
                                        <span>@Math.Abs(item.DayDifference) day@(Math.Abs(item.DayDifference) == 1 ? "" : "s") overdue</span>
                                    }
                                    else if (item.DayDifference == 0)
                                    {
                                        <span>Due today</span>
                                    }
                                    else
                                    {
                                        <span>@item.DayDifference day@(item.DayDifference == 1 ? "" : "s") remaining</span>
                                    }
                                </td>
                                <td class="whitespace-nowrap px-5 py-4 text-ink-700">@(item.ReturnDate is null ? "—" : $"{item.FineAmount:N0} MMK")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>
