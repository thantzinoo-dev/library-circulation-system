@page
@model School_Library_Management.Pages.Borrow.IndexModel
@{
    ViewData["Title"] = "Borrow Book";
}

<section class="space-y-5" data-ajax-table-page="borrow">
    <header class="page-motion page-motion-header">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-ink-900 sm:text-[28px]">Borrow Book</h1>
            <p class="mt-1 text-sm text-ink-500">Manage new and recent borrowing records</p>
        </div>
    </header>

    <a asp-page="./Create"
       class="page-motion page-motion-filter group flex flex-col gap-4 rounded-xl border border-line-200 bg-white p-5 shadow-[0_1px_2px_rgba(16,24,40,0.03)] hover:border-brand-600/40 hover:shadow-[0_8px_24px_rgba(16,24,40,0.06)] sm:flex-row sm:items-center sm:justify-between">
        <span class="flex min-w-0 items-center gap-4">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-brand-600">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H11v16H6.5A2.5 2.5 0 0 0 4 21.5v-16Z" />
                    <path d="M20 5.5A2.5 2.5 0 0 0 17.5 3H13v16h4.5a2.5 2.5 0 0 1 2.5 2.5v-16Z" />
                    <path d="M17 7v6M14 10h6" />
                </svg>
            </span>
            <span class="min-w-0">
                <span class="block font-semibold text-ink-900">Make a new borrow</span>
                <span class="mt-1 block text-sm text-ink-500">Find a member, choose an available book, and complete the checkout.</span>
            </span>
        </span>
        <span class="inline-flex items-center gap-2 self-start text-sm font-semibold text-brand-600 group-hover:text-brand-700 sm:self-auto">
            Start borrowing
            <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
        </span>
    </a>

    <div class="page-motion page-motion-content grid gap-4 md:grid-cols-3">
        <article class="flex items-center gap-4 rounded-xl border border-line-200 bg-white p-5"><span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-green-50 text-green-600"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2h9l4 4v13a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V5a3 3 0 0 1 3-3Z"/><path d="M14 2v5h5M7 12h6M7 16h4"/></svg></span><div><p class="text-sm text-ink-500">Active Loans</p><p class="text-2xl font-bold text-green-600">@Model.ActiveLoans</p><p class="text-xs text-ink-500">Currently borrowed books</p></div></article>
        <article class="flex items-center gap-4 rounded-xl border border-line-200 bg-white p-5"><span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-amber-50 text-amber-600"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span><div><p class="text-sm text-ink-500">Due Today</p><p class="text-2xl font-bold text-amber-600">@Model.DueToday</p><p class="text-xs text-ink-500">Books due today</p></div></article>
        <article class="flex items-center gap-4 rounded-xl border border-line-200 bg-white p-5"><span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-red-50 text-red-600"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v6M12 17h.01"/></svg></span><div><p class="text-sm text-ink-500">Overdue</p><p class="text-2xl font-bold text-red-600">@Model.OverdueLoans</p><p class="text-xs text-ink-500">Books overdue</p></div></article>
    </div>

    <div data-ajax-table-region="borrow" class="page-motion page-motion-table overflow-hidden rounded-xl border border-line-200 bg-white shadow-[0_1px_2px_rgba(16,24,40,0.03)]">
        <div class="flex items-center justify-between border-b border-line-200 px-4 py-3 sm:px-5"><h2 class="flex items-center gap-2 font-semibold text-ink-900"><svg class="h-5 w-5 text-brand-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>Recently Borrowed Books</h2><a asp-page="/History/Index" class="text-sm font-semibold text-brand-600 hover:text-brand-700">View all</a></div>
        <div class="overflow-x-auto"><table class="w-full min-w-225 text-left text-sm"><thead class="bg-slate-50 text-xs font-semibold uppercase tracking-wide text-ink-500"><tr><th class="px-5 py-3">Loan ID</th><th class="px-5 py-3">Member Name</th><th class="px-5 py-3">Book Title</th><th class="px-5 py-3">Borrow Date</th><th class="px-5 py-3">Due Date</th><th class="px-5 py-3">Status</th><th class="px-5 py-3 text-center">Action</th></tr></thead><tbody class="divide-y divide-line-200">
        @foreach (var loan in Model.RecentLoans)
        {
            var statusClass = loan.Status switch { "Issued" => "bg-green-50 text-green-700", "Due Soon" => "bg-amber-50 text-amber-700", "Returned" => "bg-blue-50 text-brand-600", _ => "bg-red-50 text-red-700" };
            <tr class="text-ink-700 hover:bg-slate-50/70"><td class="whitespace-nowrap px-5 py-3 font-semibold text-ink-900">@loan.LoanId</td><td class="whitespace-nowrap px-5 py-3">@loan.MemberName</td><td class="whitespace-nowrap px-5 py-3">@loan.BookTitle</td><td class="whitespace-nowrap px-5 py-3">@loan.BorrowDate.ToString("MMM dd, yyyy")</td><td class="whitespace-nowrap px-5 py-3">@loan.DueDate.ToString("MMM dd, yyyy")</td><td class="px-5 py-3"><span class="rounded-md px-2.5 py-1 text-xs font-semibold @statusClass">@loan.Status</span></td><td class="px-5 py-3 text-center"><a asp-page="/History/Index" asp-route-search="@loan.LoanId" asp-route-period="All" class="rounded-md border border-brand-600 px-3 py-1 text-xs font-semibold text-brand-600 hover:bg-blue-50">View</a></td></tr>
        }
        @if (Model.RecentLoans.Count == 0) { <tr><td colspan="7" class="px-5 py-10 text-center text-ink-500">No borrowing records yet.</td></tr> }
        </tbody></table></div>
        <div class="flex flex-col gap-4 border-t border-line-200 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
            <p class="text-sm text-ink-500">
                Showing <span class="font-medium text-ink-900">@Model.StartItem</span> to <span class="font-medium text-ink-900">@Model.EndItem</span> of <span class="font-medium text-ink-900">@Model.TotalItems</span> borrowing records
            </p>

            @if (Model.TotalPages > 1)
            {
                <nav data-ajax-pagination class="flex items-center gap-1" aria-label="Borrowing records pagination">
                    <a asp-page="./Index" asp-route-pageIndex="1"
                       class="inline-flex h-8 min-w-8 items-center justify-center rounded-lg border border-line-300 bg-white px-2 text-xs font-semibold text-ink-700 transition-colors hover:bg-slate-50 @(Model.PageIndex == 1 ? "pointer-events-none opacity-40" : null)"
                       aria-label="First page" title="First page">«</a>
                    <a asp-page="./Index" asp-route-pageIndex="@(Model.PageIndex - 1)"
                       class="inline-flex h-8 min-w-8 items-center justify-center rounded-lg border border-line-300 bg-white px-2 text-xs font-semibold text-ink-700 transition-colors hover:bg-slate-50 @(!Model.HasPreviousPage ? "pointer-events-none opacity-40" : null)"
                       aria-label="Previous page" title="Previous page">‹</a>

                    @{
                        var startPage = Math.Max(1, Model.PageIndex - 2);
                        var endPage = Math.Min(Model.TotalPages, startPage + 4);
                        if (endPage - startPage < 4)
                        {
                            startPage = Math.Max(1, endPage - 4);
                        }
                    }

                    @for (var pageNumber = startPage; pageNumber <= endPage; pageNumber++)
                    {
                        if (pageNumber == Model.PageIndex)
                        {
                            <span class="inline-flex h-8 min-w-8 items-center justify-center rounded-lg bg-brand-600 px-2.5 text-xs font-bold text-white shadow-sm" aria-current="page">@pageNumber</span>
                        }
                        else
                        {
                            <a asp-page="./Index" asp-route-pageIndex="@pageNumber" class="inline-flex h-8 min-w-8 items-center justify-center rounded-lg border border-line-300 bg-white px-2.5 text-xs font-semibold text-ink-700 transition-colors hover:bg-slate-50">@pageNumber</a>
                        }
                    }

                    <a asp-page="./Index" asp-route-pageIndex="@(Model.PageIndex + 1)"
                       class="inline-flex h-8 min-w-8 items-center justify-center rounded-lg border border-line-300 bg-white px-2 text-xs font-semibold text-ink-700 transition-colors hover:bg-slate-50 @(!Model.HasNextPage ? "pointer-events-none opacity-40" : null)"
                       aria-label="Next page" title="Next page">›</a>
                    <a asp-page="./Index" asp-route-pageIndex="@Model.TotalPages"
                       class="inline-flex h-8 min-w-8 items-center justify-center rounded-lg border border-line-300 bg-white px-2 text-xs font-semibold text-ink-700 transition-colors hover:bg-slate-50 @(Model.PageIndex == Model.TotalPages ? "pointer-events-none opacity-40" : null)"
                       aria-label="Last page" title="Last page">»</a>
                </nav>
            }
        </div>
    </div>
</section>
